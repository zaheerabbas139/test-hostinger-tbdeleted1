# ----------------------------------------------------------------------
# Hostinger LiteSpeed / Apache Configuration for Astro Static Site
# ----------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

# Enable Rewrite Engine for Clean URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Legacy pranast.com URLs that are still indexed (301 permanent redirects)
  RewriteRule ^digital-transformation-where-to-start/?$ /blog/digital-transformation-where-to-start/ [R=301,L]
  RewriteRule ^the-power-of-microsoft-power-platform/?$ /blog/the-power-of-microsoft-power-platform/ [R=301,L]
  RewriteRule ^understanding-zero-trust-security-architecture/?$ /blog/understanding-zero-trust-security-architecture/ [R=301,L]
  RewriteRule ^google-sheets-vs-dynamics-365/?$ /blog/google-sheets-vs-dynamics-365/ [R=301,L]
  RewriteRule ^why-digital-transformation-projects-fail/?$ /blog/why-digital-transformation-projects-fail/ [R=301,L]
  RewriteRule ^the-hidden-security-risks-of-rapid-digital-transformation/?$ /blog/the-hidden-security-risks-of-rapid-digital-transformation/ [R=301,L]
  RewriteRule ^(globaltech-solutions|premier-law-associates)/?$ /case-studies/$1/ [R=301,L]
  RewriteRule ^terms-of-services/?$ /terms-of-service/ [R=301,L]
  RewriteRule ^(home|services|insights)/?$ / [R=301,L]
  RewriteRule ^author/ /blog/ [R=301,L]

  # Redirect trailing slash to non-trailing slash (optional, canonicalization)
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteRule ^(.*)/$ /$1 [L,R=301]

  # Serve HTML file if exists without .html extension
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Browser Caching Headers (Leverage Browser Cache)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML pages - no cache or very short cache to allow instantaneous updates
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media: Images, Icons, Fonts
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

