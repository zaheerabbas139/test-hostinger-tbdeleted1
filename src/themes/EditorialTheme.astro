---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import type { Author } from '../data/authors';
import BlogCard from '../components/BlogCard.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: MarkdownHeading[];
  author: Author;
  formattedDate: string;
  previousPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const {
  post,
  headings = [],
  author,
  formattedDate,
  previousPost,
  nextPost,
  relatedPosts = [],
} = Astro.props;
---

<!-- Editorial / Magazine Theme Scaffolding (Full layout enhanced in Stage 2) -->
<article class="py-16 bg-[#faf9f6] text-slate-800">
  <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="flex items-center gap-3 mb-4">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
        {post.data.category}
      </span>
      <span class="text-xs text-slate-500 font-medium">Editorial Preview</span>
      <span class="text-slate-300">•</span>
      <time class="text-xs text-slate-500" datetime={post.data.date}>{formattedDate}</time>
    </div>
    <h1 class="text-3xl sm:text-5xl font-serif font-bold text-slate-900 tracking-tight leading-tight">
      {post.data.title}
    </h1>
    {post.data.description && (
      <p class="text-xl text-slate-600 font-serif italic mt-4 leading-relaxed">
        {post.data.description}
      </p>
    )}
  </header>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>
  </div>

  <!-- Author box -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pt-10 border-t border-slate-200">
    <div class="flex flex-col sm:flex-row gap-6 items-start">
      <img src={author.avatar} alt={author.name} width="96" height="96" class="w-20 h-20 rounded-full object-cover flex-shrink-0" loading="lazy" decoding="async" />
      <div>
        <p class="text-base font-serif font-bold text-slate-900">{author.name}</p>
        <p class="text-sm text-slate-600 leading-relaxed mt-1 mb-3">{author.bio}</p>
        <a href="/blog/" class="text-sm font-semibold text-emerald-700 hover:text-emerald-900">More stories by {author.name} &rarr;</a>
      </div>
    </div>
  </div>

  <!-- Related posts -->
  {relatedPosts.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pt-10 border-t border-slate-200" aria-labelledby="editorial-related-posts">
      <h2 id="editorial-related-posts" class="text-2xl font-serif font-bold text-slate-900 mb-8">Related Stories</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {relatedPosts.map((related) => (
          <BlogCard post={related} showExcerpt={false} />
        ))}
      </div>
    </section>
  )}
</article>

