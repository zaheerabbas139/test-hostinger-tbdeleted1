---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import type { Author } from '../data/authors';
import BlogCard from '../components/BlogCard.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: MarkdownHeading[];
  author: Author;
  formattedDate: string;
  previousPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const {
  post,
  headings = [],
  author,
  formattedDate,
  previousPost,
  nextPost,
  relatedPosts = [],
} = Astro.props;
---

<!-- Modern Tech / SaaS Theme Scaffolding (Full layout enhanced in Stage 3) -->
<article class="py-16 bg-slate-50 text-slate-900">
  <!-- Split / Modern Hero -->
  <header class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700">
            {post.data.category}
          </span>
          <span class="text-xs text-indigo-600 font-semibold uppercase tracking-wider">Modern SaaS Preview</span>
          <span class="text-slate-300">•</span>
          <time class="text-xs text-slate-500" datetime={post.data.date}>{formattedDate}</time>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p class="text-lg text-slate-600 mt-4 leading-relaxed">
            {post.data.description}
          </p>
        )}
      </div>
      {post.data.featured_image && (
        <div class="lg:col-span-5">
          <img
            src={post.data.featured_image}
            alt={post.data.featured_image_alt || post.data.title}
            class="rounded-2xl shadow-xl border border-slate-200/80 w-full object-cover aspect-video"
            loading="eager"
            onerror="this.onerror=null; this.src='/assets/images/Banner-03-1.png';"
          />
        </div>
      )}
    </div>
  </header>

  <!-- Content -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 bg-white py-10 px-8 rounded-2xl shadow-sm border border-slate-200/60">
    <div class="prose max-w-none">
      <slot />
    </div>
  </div>

  <!-- Author & Related Bento Cards -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/60 md:col-span-1">
        <div class="flex items-center gap-4">
          <img src={author.avatar} alt={author.name} width="64" height="64" class="w-16 h-16 rounded-full object-cover" loading="lazy" decoding="async" />
          <div>
            <h3 class="font-bold text-slate-900 text-base">{author.name}</h3>
            <p class="text-xs text-indigo-600 font-medium">Author</p>
          </div>
        </div>
        <p class="text-xs text-slate-600 mt-3 leading-relaxed">{author.bio}</p>
      </div>

      <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white p-6 rounded-2xl shadow-sm md:col-span-2 flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-indigo-300 uppercase tracking-wider">Enterprise Transformation</span>
          <h3 class="text-xl font-bold mt-2">Ready to modernise your digital infrastructure?</h3>
          <p class="text-slate-300 text-sm mt-2">Connect with our certified solution architects for a strategic roadmap consultation.</p>
        </div>
        <div class="mt-6">
          <a href="/contact/" class="inline-flex items-center px-4 py-2 rounded-lg bg-indigo-500 hover:bg-indigo-400 text-white text-sm font-semibold transition">
            Book an Advisory Session &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Related posts -->
  {relatedPosts.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-16" aria-labelledby="modern-related-posts">
      <h2 id="modern-related-posts" class="text-2xl font-bold text-slate-900 mb-8">Related Insights</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {relatedPosts.map((related) => (
          <BlogCard post={related} showExcerpt={false} />
        ))}
      </div>
    </section>
  )}
</article>

