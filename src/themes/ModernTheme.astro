---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import type { Author } from '../data/authors';
import ReadingProgress from '../components/themes/ReadingProgress.astro';
import BlogCard from '../components/BlogCard.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: MarkdownHeading[];
  author: Author;
  formattedDate: string;
  previousPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const {
  post,
  headings = [],
  author,
  formattedDate,
  previousPost,
  nextPost,
  relatedPosts = [],
} = Astro.props;

// Calculate estimated reading time based on word count
const wordCount = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 225));
const readingTimeText = `${readingMinutes} min read`;

// Filter major sections for quick jump
const quickSections = headings.filter((h) => h.depth === 2);
---

<!-- Modern SaaS / Bento Theme (Stage 3) -->
<article class="relative bg-slate-50 text-slate-900 antialiased selection:bg-indigo-100 selection:text-indigo-900 pb-24">
  <!-- Pinned Reading Progress Bar -->
  <ReadingProgress targetSelector="#modern-article-content" />

  <!-- High-Tech Top Navigation Bar Chrome -->
  <div class="border-b border-slate-200/70 bg-white/70 backdrop-blur-md sticky top-0 z-30 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between text-xs">
      <nav class="flex items-center gap-2 text-slate-500 font-medium overflow-hidden" aria-label="Breadcrumb">
        <a href="/" class="hover:text-indigo-600 transition flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Home</span>
        </a>
        <span class="text-slate-300">/</span>
        <a href="/blog/" class="hover:text-indigo-600 transition">Blog</a>
        <span class="text-slate-300">/</span>
        <span class="text-indigo-600 font-semibold">{post.data.category}</span>
        <span class="text-slate-300 hidden md:inline">/</span>
        <span class="text-slate-600 truncate max-w-xs hidden md:inline font-normal">{post.data.title}</span>
      </nav>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <button
          type="button"
          id="modern-copy-link-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 border border-slate-200 transition shadow-2xs cursor-pointer"
          title="Copy post link"
        >
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="modern-copy-text">Share</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 50/50 Split Modern SaaS Hero Header -->
  <header class="relative pt-12 pb-16 sm:py-20 overflow-hidden bg-gradient-to-b from-slate-100/80 via-slate-50 to-slate-50 border-b border-slate-200/60">
    <!-- Ambient Tech Glow Accents -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-1/2 -right-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Side: Metadata & Dynamic Typography -->
        <div class="lg:col-span-7 flex flex-col items-start">
          <!-- Tech Pill Badges Row -->
          <div class="flex flex-wrap items-center gap-2.5 mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200/70 shadow-2xs">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
              {post.data.category}
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200/80">
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{readingTimeText}</span>
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200/80">
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <time datetime={post.data.date}>{formattedDate}</time>
            </span>
          </div>

          <!-- Bold High-Impact Headline -->
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
            {post.data.title}
          </h1>

          <!-- Dek / Subtitle -->
          {post.data.description && (
            <p class="text-lg sm:text-xl text-slate-600 mt-5 leading-relaxed font-normal">
              {post.data.description}
            </p>
          )}

          <!-- Author Profile Bar & Quick Tags -->
          <div class="mt-8 pt-6 border-t border-slate-200/80 w-full flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <img
                src={author.avatar}
                alt={author.name}
                width="48"
                height="48"
                class="w-12 h-12 rounded-full object-cover border-2 border-white shadow-sm ring-1 ring-slate-200 flex-shrink-0"
                loading="eager"
              />
              <div>
                <div class="flex items-center gap-1.5">
                  <h2 class="text-sm font-bold text-slate-900 leading-tight">
                    {author.name}
                  </h2>
                  <svg class="w-4 h-4 text-blue-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">Enterprise Solutions Architect</p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <a
                href="#bento-navigation"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold text-indigo-600 bg-indigo-50/80 hover:bg-indigo-100 transition"
              >
                <span>Explore Insights</span>
                <span>&darr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Side: Split-Hero Media Showcase -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Glassmorphic Backlight Glow -->
            <div class="absolute -inset-1.5 bg-gradient-to-r from-indigo-500 to-cyan-500 rounded-3xl blur-lg opacity-30 group-hover:opacity-60 transition duration-1000"></div>

            <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-900 shadow-2xl border border-slate-700/60 ring-1 ring-slate-900/10">
              <img
                src={post.data.featured_image}
                alt={post.data.featured_image_alt || post.data.title}
                class="w-full h-auto aspect-video object-cover transform hover:scale-105 transition duration-700 ease-out"
                loading="eager"
                onerror="this.onerror=null; this.src='/assets/images/Banner-03-1.png';"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>
              
              <!-- Floating Pill on Image -->
              <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white/90 text-xs px-3 py-2 rounded-xl bg-slate-900/70 backdrop-blur-md border border-white/10">
                <span class="font-medium truncate max-w-[200px]">{post.data.category}</span>
                <span class="text-cyan-400 font-semibold uppercase tracking-wider text-[10px]">Prana Solutions</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- Quick Jump Anchor Bar (if headings exist) -->
  {quickSections.length > 0 && (
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 relative z-10">
      <div class="bg-white/95 backdrop-blur-md rounded-2xl p-4 shadow-sm border border-slate-200/80 flex items-center gap-3 overflow-x-auto text-xs no-scrollbar">
        <span class="font-bold text-slate-800 uppercase tracking-wider text-[11px] flex-shrink-0 flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Jump to:</span>
        </span>
        <div class="flex items-center gap-2">
          {quickSections.map((sec) => (
            <a
              href={`#${sec.slug}`}
              class="px-3 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 text-slate-700 hover:text-indigo-700 font-medium whitespace-nowrap transition border border-slate-200/60"
            >
              {sec.text}
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Main Article Body Container -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-12" id="modern-article-content">
    <div class="bg-white rounded-3xl shadow-xs border border-slate-200/80 p-6 sm:p-10 lg:p-14">
      <!-- Modern Prose Content -->
      <div class="modern-content">
        <slot />
      </div>

      <!-- Article Completion Marker & Social Utility -->
      <div class="mt-14 pt-8 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-indigo-50 text-indigo-600 font-bold text-xs">
            ✓
          </span>
          <span class="text-xs font-semibold text-slate-700">Finished Reading</span>
        </div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="modern-back-to-top"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-indigo-600 bg-slate-50 hover:bg-indigo-50 border border-slate-200 transition cursor-pointer"
          >
            <span>Back to top</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Dynamic Bento Grid Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-20" id="bento-navigation" aria-label="Article Bento Grid and Next Steps">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Enterprise Blueprint</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Next Steps & Insights Bento</h2>
      </div>
    </div>

    <!-- Asymmetric Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Bento Tile 1: Enterprise Modernization CTA (Spans 2 cols) -->
      <div class="md:col-span-2 relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 text-white p-8 sm:p-10 shadow-lg border border-slate-800 flex flex-col justify-between group">
        <!-- Background Ambient Circuit Accent -->
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/20 rounded-full blur-2xl group-hover:bg-indigo-500/30 transition duration-500"></div>

        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-semibold mb-4">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            Cloud & Cyber Security Advisory
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-snug">
            Ready to accelerate your Microsoft digital ecosystem?
          </h3>
          <p class="text-slate-300 text-sm sm:text-base mt-3 max-w-xl leading-relaxed">
            From Zero-Trust hardening to Dynamics 365 and Power Platform automation, our certified solutions architects guide your modernization journey.
          </p>
        </div>

        <div class="relative z-10 mt-8 pt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-4 text-xs text-slate-400">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-cyan-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Zero Downtime
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-cyan-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Tailored Architecture
            </span>
          </div>
          <a
            href="/contact/"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-cyan-500 hover:from-indigo-400 hover:to-cyan-400 text-white font-semibold text-sm shadow-md shadow-indigo-500/20 transition transform hover:-translate-y-0.5"
          >
            <span>Book Consultation</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Bento Tile 2: Author Specialist Bento (1 col) -->
      <div class="bg-white rounded-3xl p-7 shadow-xs border border-slate-200/80 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Author & Specialist</span>
            <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md">Verified</span>
          </div>
          <div class="flex items-center gap-3.5 mb-4">
            <img
              src={author.avatar}
              alt={author.name}
              width="56"
              height="56"
              class="w-14 h-14 rounded-full object-cover border border-slate-200 shadow-xs flex-shrink-0"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h4 class="font-extrabold text-slate-900 text-base leading-tight">{author.name}</h4>
              <p class="text-xs text-indigo-600 font-semibold mt-0.5">Solution Architect</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            {author.bio}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
          <a
            href="/blog/"
            class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition inline-flex items-center gap-1"
          >
            <span>More from author</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Bento Tile 3: Post Flow Navigation (Spans 3 cols or split cards) -->
      {(previousPost || nextPost) && (
        <div class="md:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-6">
          {previousPost ? (
            <a
              href={`/blog/${previousPost.id}/`}
              class="group relative overflow-hidden bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs hover:border-indigo-300 hover:shadow-md transition flex flex-col justify-between"
            >
              <div>
                <span class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-slate-400 group-hover:text-indigo-600 transition mb-2">
                  &larr; Previous Article
                </span>
                <h4 class="font-bold text-slate-900 group-hover:text-indigo-600 transition line-clamp-2 text-base leading-snug">
                  {previousPost.data.title}
                </h4>
              </div>
              <p class="text-xs text-slate-500 mt-3 flex items-center gap-1">
                <span>In</span>
                <span class="font-medium text-slate-700">{previousPost.data.category}</span>
              </p>
            </a>
          ) : (
            <div class="hidden sm:block rounded-3xl border border-dashed border-slate-200 bg-slate-50/50 p-6 flex items-center justify-center text-xs text-slate-400 font-medium">
              Start of Article Stream
            </div>
          )}

          {nextPost ? (
            <a
              href={`/blog/${nextPost.id}/`}
              class="group relative overflow-hidden bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs hover:border-indigo-300 hover:shadow-md transition flex flex-col justify-between sm:text-right"
            >
              <div>
                <span class="inline-flex items-center justify-end gap-1 text-xs font-bold uppercase tracking-wider text-slate-400 group-hover:text-indigo-600 transition mb-2">
                  Next Article &rarr;
                </span>
                <h4 class="font-bold text-slate-900 group-hover:text-indigo-600 transition line-clamp-2 text-base leading-snug">
                  {nextPost.data.title}
                </h4>
              </div>
              <p class="text-xs text-slate-500 mt-3 sm:justify-end flex items-center gap-1">
                <span>In</span>
                <span class="font-medium text-slate-700">{nextPost.data.category}</span>
              </p>
            </a>
          ) : (
            <div class="hidden sm:block rounded-3xl border border-dashed border-slate-200 bg-slate-50/50 p-6 flex items-center justify-center text-xs text-slate-400 font-medium sm:text-right">
              Latest Published Article
            </div>
          )}
        </div>
      )}

    </div>
  </section>

  <!-- Curated Related Insights Bento Section -->
  {relatedPosts.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pt-12 border-t border-slate-200" aria-labelledby="modern-related-insights">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Category Insights</span>
          <h2 id="modern-related-insights" class="text-2xl font-bold text-slate-900 mt-1">
            Related in {post.data.category}
          </h2>
        </div>
        <a
          href="/blog/"
          class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 inline-flex items-center gap-1 transition"
        >
          <span>View all articles</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map((related) => (
          <BlogCard post={related} showExcerpt={true} showAuthor={true} />
        ))}
      </div>
    </section>
  )}

</article>

<style>
  /* Scoped Modern Tech Prose Typography for Markdown Slot */
  :global(.modern-content) {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    color: #334155; /* slate-700 */
    font-size: 1.0625rem; /* 17px */
    line-height: 1.8;
  }

  :global(.modern-content h1) {
    font-weight: 800;
    color: #0f172a; /* slate-900 */
    font-size: 2rem;
    line-height: 1.25;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.025em;
    scroll-margin-top: 5rem;
  }

  :global(.modern-content h2) {
    font-weight: 700;
    color: #0f172a; /* slate-900 */
    font-size: 1.625rem;
    line-height: 1.3;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9; /* slate-100 */
    letter-spacing: -0.02em;
    scroll-margin-top: 5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.modern-content h2::before) {
    content: '';
    display: inline-block;
    width: 0.35rem;
    height: 1.25rem;
    background: linear-gradient(to bottom, #4f46e5, #06b6d4);
    border-radius: 9999px;
  }

  :global(.modern-content h3) {
    font-weight: 700;
    color: #0f172a;
    font-size: 1.25rem;
    line-height: 1.4;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.015em;
    scroll-margin-top: 5rem;
  }

  :global(.modern-content p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  :global(.modern-content ul) {
    list-style-type: disc;
    list-style-position: outside;
    margin-left: 1.5rem;
    margin-bottom: 1.75rem;
    color: #334155;
  }

  :global(.modern-content ol) {
    list-style-type: decimal;
    list-style-position: outside;
    margin-left: 1.5rem;
    margin-bottom: 1.75rem;
    color: #334155;
  }

  :global(.modern-content li) {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  :global(.modern-content blockquote) {
    border-left: 4px solid #6366f1; /* indigo-500 */
    background: linear-gradient(to right, rgba(238, 242, 255, 0.7), rgba(248, 250, 252, 0.4));
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    border-radius: 0 1rem 1rem 0;
    color: #1e293b;
    font-style: italic;
  }

  :global(.modern-content a) {
    color: #4f46e5; /* indigo-600 */
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #c7d2fe;
    transition: color 0.15s, text-decoration-color 0.15s;
  }

  :global(.modern-content a:hover) {
    color: #3730a3;
    text-decoration-color: #4f46e5;
  }

  :global(.modern-content img) {
    border-radius: 1rem;
    margin: 2.25rem auto;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
    border: 1px solid #e2e8f0;
  }

  :global(.modern-content pre) {
    background-color: #0f172a;
    color: #f8fafc;
    padding: 1.25rem;
    border-radius: 1rem;
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid #1e293b;
    font-size: 0.875rem;
  }

  :global(.modern-content code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background-color: #f1f5f9;
    color: #4f46e5;
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.875em;
  }

  :global(.modern-content pre code) {
    background-color: transparent;
    color: inherit;
    padding: 0;
  }

  /* Utility for hiding scrollbars in quick-jump pill bar */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initModernThemeUtilities() {
    const copyBtn = document.getElementById('modern-copy-link-btn');
    const copyText = document.getElementById('modern-copy-text');

    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const original = copyText.textContent;
          copyText.textContent = 'Copied!';
          copyBtn.classList.add('bg-indigo-600', 'text-white');
          setTimeout(() => {
            copyText.textContent = original;
            copyBtn.classList.remove('bg-indigo-600', 'text-white');
          }, 2000);
        } catch {
          copyText.textContent = 'Failed';
        }
      });
    }

    const backToTopBtn = document.getElementById('modern-back-to-top');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModernThemeUtilities);
  } else {
    initModernThemeUtilities();
  }
</script>
