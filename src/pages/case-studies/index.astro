---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const caseStudies = await getCollection('case-studies');
const hubPage = await getEntry('pages', 'case-studies');
const { Content } = hubPage ? await render(hubPage) : { Content: null };
---

<BaseLayout
  title="Case Studies & Client Outcomes"
  description="Explore how Prana Solutions Tech helps enterprises achieve infrastructure scalability, zero-downtime migrations, and Zero Trust security."
>
  <div class="bg-gradient-to-b from-slate-900 to-blue-950 text-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-2 block">Proven Results</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
          Client Success Stories
        </h1>
        <p class="text-slate-300 text-lg leading-relaxed">
          Real-world business outcomes delivered through Microsoft cloud innovation, security hardening, and digital workplace modernizations.
        </p>
      </div>
    </div>
  </div>

  <!-- Featured Case Studies Cards -->
  <div class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {caseStudies.map((cs) => (
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition p-8 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between text-xs font-semibold text-blue-600 mb-3">
                <span class="bg-blue-50 px-3 py-1 rounded-full">{cs.data.industry}</span>
                <span class="text-slate-400">{cs.data.client}</span>
              </div>
              <h2 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-blue-600 transition">
                <a href={`/case-studies/${cs.id}/`}>
                  {cs.data.title}
                </a>
              </h2>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                {cs.data.summary}
              </p>
            </div>
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/case-studies/${cs.id}/`}
                class="text-sm font-semibold text-blue-600 group-hover:text-blue-700 inline-flex items-center gap-1 group-hover:gap-2 transition"
              >
                View Full Case Study <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Hub Content -->
      {Content && (
        <div class="bg-white p-8 sm:p-12 rounded-2xl border border-slate-200">
          <article class="prose max-w-none">
            <Content />
          </article>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

