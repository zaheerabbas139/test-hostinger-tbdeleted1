---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
    props: { cs },
  }));
}

const { cs } = Astro.props;
const { Content } = await cs.render();
---

<BaseLayout
  title={`${cs.data.title} - Case Study`}
  description={cs.data.summary}
>
  <article class="py-16 bg-white">
    <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
      <div class="mb-4">
        <a href="/case-studies" class="text-sm font-medium text-blue-600 hover:text-blue-800 inline-flex items-center gap-1 mb-4">
          &larr; Back to Case Studies
        </a>
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700">
            {cs.data.industry}
          </span>
          <span class="text-xs text-slate-500">
            Client: {cs.data.client}
          </span>
        </div>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {cs.data.title}
      </h1>
      <p class="text-lg text-slate-600 mt-4 leading-relaxed">
        {cs.data.summary}
      </p>
    </header>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose max-w-none">
        <Content />
      </div>
    </div>

    <!-- CTA Section -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pt-10 border-t border-slate-200">
      <div class="bg-slate-900 text-white p-8 sm:p-12 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-2xl font-bold mb-2">Ready to achieve similar results?</h3>
          <p class="text-slate-300 text-sm">Schedule a technical discovery session with our Microsoft solutions architects.</p>
        </div>
        <a
          href="/contact"
          class="whitespace-nowrap px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition"
        >
          Request IT Assessment
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

