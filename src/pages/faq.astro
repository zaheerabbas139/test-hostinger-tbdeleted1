---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion, { type FaqGroup } from '../components/FaqAccordion.astro';

// Copy matches pranast.com's FAQ exactly, including the "TechPro Solutions" wording in the first question.
const faqGroups: FaqGroup[] = [
  {
    heading: 'General',
    items: [
      {
        question: 'What services does TechPro Solutions offer?',
        answer:
          'We offer comprehensive IT services including managed IT support, cloud solutions (Azure, Microsoft 365), cybersecurity, digital transformation with Dynamics 365 and Power Platform, and infrastructure management.',
      },
      {
        question: 'Do you support businesses of all sizes?',
        answer:
          'Yes, we work with small and medium businesses, large enterprises, and everything in between. Our solutions are scalable and tailored to meet the specific needs of your organization.',
      },
    ],
  },
  {
    heading: 'Cloud Solutions',
    items: [
      {
        question: 'Can you help migrate our on-premises infrastructure to the cloud?',
        answer:
          'Yes, we specialize in cloud migration services using Microsoft Azure. We assess your current environment, design a migration strategy, and execute the migration with minimal disruption to your operations.',
      },
      {
        question: 'What are the benefits of moving to Microsoft 365?',
        answer:
          'Microsoft 365 provides enterprise-grade productivity tools, advanced security features, anywhere access, automatic updates, scalability, and reduced IT management overhead.',
      },
    ],
  },
  {
    heading: 'Pricing & Contracts',
    items: [
      {
        question: 'How is pricing structured?',
        answer:
          'We offer flexible pricing models including monthly managed services contracts, project-based pricing, and hybrid arrangements. Contact us for a customized quote based on your specific needs.',
      },
      {
        question: 'What is the typical contract length?',
        answer:
          'We typically offer 12-month contracts for managed services, but we can accommodate different terms based on your business requirements.',
      },
    ],
  },
  {
    heading: 'Managed IT Services',
    items: [
      {
        question: 'What is included in managed IT services?',
        answer:
          'Our managed IT services include 24/7 monitoring, helpdesk support, patch management, backup and disaster recovery, endpoint management, security monitoring, and proactive maintenance.',
      },
      {
        question: 'What is your response time for support requests?',
        answer:
          'We guarantee a response time of less than 15 minutes for critical issues and less than 2 hours for standard support requests. Our support team is available 24/7/365.',
      },
    ],
  },
  {
    heading: 'Security',
    items: [
      {
        question: 'How do you protect against cyber threats?',
        answer:
          'We use a multi-layered security approach including Microsoft Security Stack (Defender, Sentinel, Intune), regular security assessments, employee training, security monitoring, and incident response capabilities.',
      },
      {
        question: 'Do you provide compliance support?',
        answer:
          'Yes, we help organizations meet various compliance requirements including GDPR, HIPAA, ISO 27001, and industry-specific regulations through proper security controls and documentation.',
      },
    ],
  },
];
---

<BaseLayout
  title="Frequently Asked Questions (FAQ)"
  description="Explore answers to common questions about Prana Solutions Tech's managed IT support, Microsoft cloud architecture, cyber security, contracts, and SLA response times."
>
  <!-- Page Hero Header -->
  <header
    class="relative bg-cover bg-center text-white py-16 lg:py-24"
    style="background-image: url('/assets/images/Screenshot-2026-01-29-180248.png');"
  >
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/95 via-blue-950/90 to-slate-900/95"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
        Frequently Asked Questions
      </h1>
    </div>
  </header>

  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-12">
        Get answers to common questions about our services, processes, and how we can help your business.
      </p>
      <FaqAccordion groups={faqGroups} />
    </div>
  </section>
</BaseLayout>
