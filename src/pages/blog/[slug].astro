---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.featured_image}
>
  <article class="py-16 bg-white">
    <!-- Post Header -->
    <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
      <div class="mb-4">
        <a href="/blog" class="text-sm font-medium text-blue-600 hover:text-blue-800 inline-flex items-center gap-1 mb-4">
          &larr; Back to Insights
        </a>
        <div class="flex items-center gap-3">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700">
            {post.data.category}
          </span>
          <span class="text-xs text-slate-500">
            Published {new Date(post.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </span>
        </div>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {post.data.title}
      </h1>
      <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-sm text-slate-600">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-xs">
            PS
          </div>
          <span>By {post.data.author}</span>
        </div>
      </div>
    </header>

    <!-- Featured Image -->
    {post.data.featured_image && (
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
        <div class="rounded-2xl overflow-hidden shadow-lg border border-slate-100 bg-slate-50 aspect-video">
          <img
            src={post.data.featured_image}
            alt={post.data.featured_image_alt || post.data.title}
            class="w-full h-full object-cover"
            onerror="this.onerror=null; this.src='/assets/images/Banner-03-1.png';"
          />
        </div>
      </div>
    )}

    <!-- Post Content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose max-w-none">
        <Content />
      </div>
    </div>

    <!-- Post CTA -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pt-10 border-t border-slate-200">
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-8 rounded-2xl border border-blue-100 text-center sm:text-left sm:flex items-center justify-between gap-6">
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-1">Need help implementing this?</h3>
          <p class="text-sm text-slate-600">Our Microsoft Solutions Architects can assess your architecture and guide your transformation.</p>
        </div>
        <a
          href="/contact"
          class="mt-4 sm:mt-0 whitespace-nowrap inline-block px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm transition"
        >
          Book Consultation
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

