---
import { getCollection, render } from 'astro:content';
import ThemeDispatcher from '../../layouts/ThemeDispatcher.astro';
import { getAuthor } from '../../data/authors';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const index = allPosts.findIndex((p) => p.id === post.id);
// Posts are sorted newest first: "previous" is the older post, "next" is the newer one
const previousPost = allPosts[index + 1];
const nextPost = index > 0 ? allPosts[index - 1] : undefined;
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);

const author = getAuthor(post.data.author);
const formattedDate = new Date(post.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<ThemeDispatcher
  post={post}
  headings={headings}
  author={author}
  formattedDate={formattedDate}
  previousPost={previousPost}
  nextPost={nextPost}
  relatedPosts={relatedPosts}
>
  <Content />
</ThemeDispatcher>

