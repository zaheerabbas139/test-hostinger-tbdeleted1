---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  // Exclude 'home' and 'case-studies' which have dedicated top-level page routes
  const filteredPages = pages.filter((p) => p.slug !== 'home' && p.slug !== 'case-studies');

  return filteredPages.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const isContactPage = entry.slug === 'contact';
const isBridgeADPage = entry.slug === 'bridgead';
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <!-- Page Hero Header -->
  <header class="bg-gradient-to-b from-slate-900 to-blue-950 text-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight mb-4">
          {entry.data.title}
        </h1>
        {entry.data.description && (
          <p class="text-slate-300 text-lg leading-relaxed">
            {entry.data.description}
          </p>
        )}
      </div>
    </div>
  </header>

  <!-- Page Body -->
  <div class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <article class="prose max-w-none">
        <Content />
      </article>

      {isContactPage && (
        <div class="mt-12">
          <ContactForm />
        </div>
      )}

      {isBridgeADPage && (
        <div class="mt-16 p-8 rounded-2xl bg-blue-50 border border-blue-200 text-center">
          <h3 class="text-2xl font-bold text-slate-900 mb-2">Accelerate Your Active Directory Migration</h3>
          <p class="text-slate-600 mb-6 max-w-2xl mx-auto text-sm">
            Speak with our identity architects for a demonstration of how BridgeAD reduces cloud migration timelines by up to 60%.
          </p>
          <a
            href="/contact"
            class="inline-block px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-lg shadow-md transition"
          >
            Request BridgeAD Demo
          </a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

