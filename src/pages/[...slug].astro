---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  // Exclude routes with dedicated first-class templates
  const dedicatedRoutes = new Set(['home', 'case-studies', 'bridgead', 'faq']);
  const filteredPages = pages.filter((p) => !dedicatedRoutes.has(p.id));

  return filteredPages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isContactPage = entry.id === 'contact';
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <!-- Page Hero Header -->
  <header
    class:list={[
      'relative text-white py-16 lg:py-24',
      entry.data.featured_image ? 'bg-cover bg-center' : 'bg-gradient-to-b from-slate-900 to-blue-950',
    ]}
    style={entry.data.featured_image ? `background-image: url('${entry.data.featured_image}');` : undefined}
  >
    {entry.data.featured_image && (
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/95 via-blue-950/90 to-slate-900/95"></div>
    )}
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
          {entry.data.title}
        </h1>
      </div>
    </div>
  </header>

  <!-- Page Body -->
  <div class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <article class="prose max-w-none">
        <Content />
      </article>

      {isContactPage && (
        <div class="mt-12">
          <ContactForm />
        </div>
      )}
    </div>
  </div>
</BaseLayout>

