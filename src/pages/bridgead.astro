---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion, { type FaqGroup } from '../components/FaqAccordion.astro';

// Copy matches pranast.com/bridgead/ exactly, including its existing typos.
const tiles = [
  { title: 'Cloud decisions', desc: 'Assessment, target design, plan and evidence' },
  { title: 'Microsoft workloads', desc: 'AD, Entra ID, Exchange, SharePoint and Teams - plus any-to-any mailbox routes' },
  { title: 'Migration intelligence', desc: 'Cited answers, failures and reports' },
  { title: 'Governed delivery', desc: 'Approvals, validation and audit evidence' },
];

const insideSteps = [
  { title: 'Select', desc: 'Choose validated source and destination connections, agents, assessed objects, users, sites, mailboxes, or servers.' },
  { title: 'Preview', desc: 'Run dry-run or readiness checks, inspect collisions and unsupported items, then revise mappings or scope before writes begin.' },
  { title: 'Start', desc: 'Launch a job, wave, cloud-directory run, endpoint conversion, or server operation with the options attached to that run.' },
  { title: 'Control', desc: 'See the current item, processed and failed counts, warnings, throughput, and live state; pause, cancel, resume, or retry where supported.' },
  { title: 'Prove', desc: 'Review exceptions and validation, record acceptance, and export reports, certificates, transcripts, and audit evidence.' },
];

const bestFitPrograms = [
  { title: 'AD forest consolidation', desc: 'Discover, map, dry-run, and migrate directory objects through controlled waves.' },
  { title: 'M&A and divestitures', desc: 'Coordinate identity scope, approvals, execution, and evidence across environments.' },
  { title: 'Tenant-to-tenant planning', desc: 'Assess identity and workload readiness before committing to content- transfer scope.' },
  { title: 'Regulated self-hosted delivery', desc: 'Keep the control plane in customer-managed infrastructure with explicit cloud egress.' },
  { title: 'MSP migration delivery', desc: 'Standardize assessment, pilot boundaries, operator roles, and evidence across client programs.' },
];

const productFamily = [
  {
    title: 'BridgeAD Cloud Workloads',
    desc: 'Assess, scope, execute, reconcile, and prove Active Directory, Entra ID, Exchange, sharePoint, OneDrive, and Teams migrations - plus any-to-any mailbox moves across Gmail, IMAR on-premises Exchange, and archives.',
  },
  {
    title: 'BridgeAD Intelligence',
    desc: 'Assess cloud estates, compare target designs, verify plans, govern execution, investigate failures, and prepare cited reports.',
  },
];

const cloudCapabilities = [
  {
    title: 'Active Directory',
    desc: 'Supported discovery, mapping, CSV workflows, collision checks, and dry runs. Topology-specific controlled pilots then cover execution, delta, SID, ACL, password, and rollback workflows.',
  },
  {
    title: 'Mailbox migration - any to any',
    desc: 'Certified routes between Exchange Online tenants, Gmail, IMAP hosts, on-premises Exchange (EWS), and PST/EML archives - mail, owned calendars, contacts, and tasks with resumable delta passes, signed fidelity contracts, and offline-verifiable custody evidence.',
  },
  {
    title: 'SharePoint & OneDrive',
    desc: 'Assessment-backed site and drive scoping with resumable Graph content transfer. Conflict handling and version depth are configurable. Permissions are mapped, lists are supported, and delta passes end in reconciliation.',
  },
  {
    title: 'Microsoft Teams',
    desc: 'Graph reconstruction for team and channel structure, mapped membership, supported settings, tabs, and tags. Microsoft-native channel-message import is conditional.',
  },
  {
    title: 'Microsoft Entra ID',
    desc: 'Graph-based users, groups, devices, and memberships with collision protection. Adds governed guest invitations, selected application definitions, and conditional Intune policy definitions.',
  },
  {
    title: 'Audit & Compliance',
    desc: 'Supported audit logging with hash-chain verification, correlation IDs, role-change traceability, and exportable operational reports.',
  },
];

const workloadRows = [
  { capability: 'AD discovery, mapping, CSV validation, and dry run', status: 'Supported', boundary: 'Available for orchestrating when connections and permissions validate.' },
  { capability: 'AD migration orchestration and rollback', status: 'Supported', boundary: 'Dry-run first with success criteria; per-step rollback, automated rollback rules, and connectivity circuit breakers are built in.' },
  { capability: 'SID history and ACL remapping', status: 'Supported', boundary: 'Agent-executed with streamed progress and evidence; multi-forest translation follows applied sync and one mapped peer link.' },
  { capability: 'Entra users, groups, devices, and memberships', status: 'Supported', boundary: 'Configured Graph permissions required; synchronized attributes remain owned by Entra Connect or Cloud Sync.' },
  { capability: 'Entra tenant-to-tenant users and static groups', status: 'Supported', boundary: 'Preview-first route with UPN transformation, optional update-existing reruns, and membership reconciliation; licenses, mailboxes, and MFA registration remain separate.' },
  { capability: 'Google Workspace directory to Entra or AD', status: 'Supported', boundary: 'Users and groups only through domain-wide delegation; Gmail, Drive, Calendar, and source passwords are excluded from rollout.' },
  { capability: 'Cloud-native device conversion', status: 'Supported', boundary: 'AD unjoin, Entra join, Microsoft 365 app reset, and BitLocker escrow verification — dry-run first, using a customer-built provisioning package and a per-device SYSTEM agent.' },
  { capability: 'IIS and SQL Server migration', status: 'Supported', boundary: 'Agent-executed configuration and credential moves with preview and confirmation gates; TLS keys, TDE prerequisites, and break-glass secrets remain explicit boundary items.' },
  { capability: 'Exchange Online mailbox content and cutover evidence', status: 'Supported', boundary: 'Microsoft 365 tenant-to-tenant Graph path plus certified any-to-any routes (Gmail, IMAP, EWS, archives); in-place archives and public folders migrate via the certified EWS route, with license assignment for re-guard.' },
  { capability: 'SharePoint, OneDrive, and supported list content', status: 'Supported', boundary: 'Scoped Graph transfer; full app-fidelity, sharing links, and tenant governance are not implied.' },
  { capability: 'Teams structure, membership, settings, tabs, and tags', status: 'Supported', boundary: 'Graph reconstruction; files and meetings move through their owning workloads.' },
  { capability: 'Teams channel messages', status: 'Conditional', boundary: 'Requires Microsoft-protected-API approval and opt-in migration mode; attachments move through SharePoint and reactions are not preserved.' },
  { capability: 'Teams private chats', status: 'Conditional', boundary: 'Re-creates mapped chat shells and walks full-history transport via destination OneDrive; requires secure Chat.Read.All, and history is not replayed into destination threads.' },
];

const howItWorks = [
  { title: 'Discover', desc: 'Connect source and destination environments and run read-only discovery. Baseline identity, directory, and workload readiness before scope is committed.' },
  { title: 'Plan', desc: 'Build mapping rules, wave strategy, and rollback guardrails. Dry-run validates assumptions. It produces a clear execution plan per migration phase.' },
  { title: 'Execute', desc: 'Execute dependency-ordered jobs with retry, resume, and real-time progress telemetry. Pause, resume, cancel, or retry failed items without losing control.' },
  { title: 'Verify & close', desc: 'Run reconciliation checks and export audit and job reports. Close with governed handover and operational evidence for client, security, and compliance teams.' },
];

const operations = [
  { title: 'Assessment & reporting', desc: 'Pre-migration readiness scoring, finding categorisation, and exportable reports in CSV, Excel, and PDF formats.' },
  { title: 'Real-time operations', desc: 'SignalR live dashboards, health checks, metrics endpoints, and alert-ready telemetry for NOC and delivery teams.' },
  { title: 'API & automation', desc: 'Comprehensive authenticated APIs and signed webhook notifications. Integrates with ITSM, SIEM, and internal orchestration pipelines.' },
  { title: 'On-prem execution agent', desc: 'Outbound-only Windows agent with pairing, heartbeat monitoring, command dispatch, and controlled auto-update workflows.' },
];

const securityPoints = [
  'Customer migration content is streamed source → destination; no mailbox, file, or message body is persisted at rest in BridgeAD infrastructure.',
  'All Microsoft Graph and Exchange traffic is TLS 1.2+; internal control plane uses TLS termination and mutual authentication.',
  'Secrets are stored in Azure Key Vault (SaaS) or DPAPI-protected local stores (self-hosted). Access tokens are never logged.',
  'Multi-tenant deployments enforce per-tenant data isolation via Entity Framework query filters and database-level row filters.',
  'Five-tier RBAC (Viewer, Migration Operator, Tenant Admin, Platform Admin, Super Admin) with mandatory MFA for all privileged roles.',
  'Self-hosted edition keeps every byte of customer data inside the customer\'s own infrastructure.',
];

const deploymentModels = [
  { title: 'SaaS', desc: 'Multi-tenant managed service hosted on Azure. Region-pinned data residency. Per-seat or per-mailbox licensing. Fastest path to first migration.' },
  { title: 'Self-hosted', desc: 'Single-tenant deployment inside the customer\'s Azure subscription, Kubernetes environment, or Docker host. Microsoft 365 workloads still require approved outbound access to Microsoft APIs.' },
];

const trustPoints = [
  { title: 'Direct accountability', desc: 'Migration engineering, security review, and commercial questions route to the team that ships the product. The same engineers who write the orchestration review your controlled-pilot plan.' },
  { title: 'Claim discipline', desc: 'Every public capability statement maps to a reviewed claim ledger and a readiness status — Supported, Conditional, Controlled pilot, or Manual. We publish boundaries next to claims rather than behind a sales call.' },
  { title: 'Deployment control', desc: 'Run managed SaaS with region-pinned residency, or self-host inside your own subscription, Kubernetes cluster, or Docker host. Your compliance boundary is a first-class design input, not an afterthought.' },
  { title: 'Evidence over assurance', desc: 'Assessment findings, dry runs, reconciliation, and sign-off exports are produced as verifiable artifacts. You evaluate us on what the platform records, not on what we promise.' },
];

const faqGroups: FaqGroup[] = [
  {
    items: [
      {
        question: 'Do we need an agent on every user workstation?',
        answer:
          'Not for directory or Microsoft 365 workload migrations: one healthy agent per reachable domain is often sufficient. Device-local workflows such as controlled-pilot cloud-native conversion are different. They require a healthy agent running as SYSTEM on each target Windows device for the conversion window.',
      },
      {
        question: 'Does BridgeAD store our mailbox or file content?',
        answer:
          'No. Migration content is streamed in transit from source to destination. Only metadata required for orchestration (job state, error counts, audit records) is persisted – never bodies of mail, files, or messages.',
      },
      {
        question: 'What is your Microsoft 365 workload migration readiness?',
        answer:
          'Exchange Online mailbox content (including certified any-to-any routes to and from Gmail, IMAP, on-premises Exchange, and PST/EML archives), SharePoint and OneDrive content, and Teams structure reconstruction are supported within their documented prerequisites and exclusions. Teams channel-message import is conditional on Microsoft protected-API approval. See the workload directory for exact scope and manual boundaries.',
      },
      {
        question: 'Where does our data live in the SaaS edition?',
        answer:
          'You pin a primary Azure region at provisioning. All customer-scoped data (audit log, configuration, secrets in Azure Key Vault) stays in that region. Operational telemetry may be processed in additional regions under SCC-equivalent safeguards.',
      },
      {
        question: 'Can we run BridgeAD on-prem or in our own subscription?',
        answer:
          'Yes. The self-hosted edition deploys via Helm chart, raw Kubernetes manifests, or Docker Compose, and runs entirely inside your subscription or data centre. SaaS and self-hosted ship from the same codebase.',
      },
      {
        question: 'How is access controlled?',
        answer:
          'Five-tier RBAC: Viewer, Migration Operator, Tenant Admin, Platform Admin, Super Admin. MFA is mandatory for every privileged role. All sign-ins and privilege changes are recorded to the immutable audit log.',
      },
      {
        question: 'Can BridgeAD integrate with our internal tooling?',
        answer:
          'Yes. BridgeAD exposes authenticated REST APIs and webhook notifications for job events and audit automation. Downstream integrations include ITSM, SIEM, and delivery runbooks.',
      },
      {
        question: 'Do you offer a sandbox or proof-of-concept?',
        answer:
          'Yes. Request a scoped PoC at sales[at]bridgead[dot]in with your source & destination tenant context.',
      },
    ],
  },
];
---

<BaseLayout
  title="BridgeAD - Intelligent Migration & Digital Transformation Platform"
  description="Enterprise platform to simplify, govern, and accelerate Active Directory, Microsoft Entra ID, and Microsoft 365 migration programmes with zero data retention at rest."
  image="/assets/images/intelligence-dashboard.webp"
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900 text-white py-20 lg:py-28 overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-6">
          Intelligent Migration &amp; Digital Transformation Platform
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 mb-8 leading-relaxed">
          A technology platform designed to simplify, govern and accelerate Active Directory, Microsoft Entra ID and Microsoft 365 migration programmes.
        </p>
        <a href="/contact/" class="inline-block px-8 py-3.5 rounded-xl text-sm font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition">
          Get In Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Product showcase: tabs -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-2 mb-6" role="tablist">
        <button type="button" role="tab" data-tab="intelligence" aria-selected="true" aria-controls="tab-intelligence" class="px-4 py-2 rounded-lg text-sm font-semibold bg-blue-600 text-white">Intelligence</button>
        <button type="button" role="tab" data-tab="cloud-workloads" aria-selected="false" aria-controls="tab-cloud-workloads" class="px-4 py-2 rounded-lg text-sm font-semibold bg-slate-100 text-slate-700">Cloud Workloads</button>
      </div>
      <div id="tab-intelligence" role="tabpanel">
        <img src="/assets/images/intelligence-dashboard.webp" alt="" width="1600" height="900" class="w-full rounded-2xl border border-slate-200 shadow-md" loading="lazy" decoding="async" />
      </div>
      <div id="tab-cloud-workloads" role="tabpanel" hidden>
        <img src="/assets/images/cloud-workloads-dashboard.webp" alt="" width="1600" height="900" class="w-full rounded-2xl border border-slate-200 shadow-md" loading="lazy" decoding="async" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
        {tiles.map((tile) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{tile.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{tile.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inside the application -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Inside the application</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">From connection selection to signed-off evidence.</h2>
      <p class="text-slate-600 leading-relaxed max-w-3xl mb-10">
        BridgeAD is not only a capability catalog. Operators work through named source and destination connections. They preview changes, start bounded jobs, and watch individual items move. They can intervene safely and close each wave with inspectable outputs.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
        {insideSteps.map((step) => (
          <div class="p-6 rounded-2xl bg-white border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{step.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Best-fit programs -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Best-fit programs</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">Start with the migration you actually need to control.</h2>
      <p class="text-slate-600 leading-relaxed max-w-3xl mb-10">
        BridgeAD is designed first for AD-heavy and hybrid programs. In these programs, dependencies, operator control, rollback planning, and evidence matter as much as moving objects.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {bestFitPrograms.map((program) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{program.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{program.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Product family -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">BridgeAD product family</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">Two focused products for different migration responsibilities.</h2>
      <p class="text-slate-600 leading-relaxed max-w-3xl mb-10">
        Choose Cloud Workloads for AD and Microsoft 365 migration. Choose Intelligence for cloud assessment, planning, controlled execution, analysis, and reporting.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {productFamily.map((product) => (
          <div class="p-8 rounded-2xl bg-white border border-slate-200">
            <h3 class="text-xl font-bold text-slate-900 mb-3">{product.title}</h3>
            <p class="text-slate-600 leading-relaxed">{product.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cloud Workloads capabilities -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Cloud Workloads capabilities</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-10">Dedicated engines for identity and Microsoft 365.</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cloudCapabilities.map((capability) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{capability.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{capability.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Workload readiness -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Workload readiness</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">Know what can enter scope before the project starts.</h2>
      <p class="text-slate-600 leading-relaxed max-w-3xl mb-10">
        Status applies to the exact scope stated below. Every engagement still depends on tenant state, permissions, connectivity, and identity mappings. Service limits, validation, and owned remediation also apply.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="min-w-full text-sm text-left">
          <thead class="bg-slate-100 text-slate-700 uppercase text-xs tracking-wider">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">Capability</th>
              <th scope="col" class="px-4 py-3 font-semibold">Status</th>
              <th scope="col" class="px-4 py-3 font-semibold">Current/Delivery boundary</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {workloadRows.map((row) => (
              <tr>
                <td class="px-4 py-3 font-semibold text-slate-900 align-top">{row.capability}</td>
                <td class="px-4 py-3 align-top whitespace-nowrap">{row.status}</td>
                <td class="px-4 py-3 text-slate-600 align-top">{row.boundary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">How it works</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">From discovery to verification - in four operational phases.</h2>
      <p class="text-slate-600 leading-relaxed max-w-3xl mb-10">
        BridgeAD standardises migration delivery so teams can assess risk early, execute in controlled waves, and close with evidence-backed reporting.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {howItWorks.map((phase) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{phase.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{phase.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Operations -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Operations</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">Built for delivery teams, not just demos.</h2>
      <p class="text-slate-600 leading-relaxed max-w-3xl mb-10">
        BridgeAD includes the controls and integrations required to run migration programs at enterprise scale.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {operations.map((item) => (
          <div class="p-6 rounded-2xl bg-white border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Security -->
  <section class="py-20 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400 block mb-2">Security</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Security Migration content is streamed, not retained by the control plane.</h2>
      <p class="text-slate-300 leading-relaxed max-w-3xl mb-8">
        BridgeAD persists the operational metadata needed to orchestrate and audit work. Mail, file, and message bodies are not retained at rest in BridgeAD infrastructure.
      </p>
      <ul class="space-y-3 text-sm text-slate-300 list-disc list-inside max-w-4xl">
        {securityPoints.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Deployment -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Deployment</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">Two deployment models. One orchestration approach.</h2>
      <p class="text-slate-600 leading-relaxed max-w-3xl mb-10">
        Use managed SaaS or deploy the control plane in customer-managed infrastructure. Available features and required egress are confirmed during solution design.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {deploymentModels.map((model) => (
          <div class="p-8 rounded-2xl bg-slate-50 border border-slate-200">
            <h3 class="text-xl font-bold text-slate-900 mb-3">{model.title}</h3>
            <p class="text-slate-600 leading-relaxed">{model.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who you are trusting -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Who you are trusting</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">Built and operated by the team you hold accountable.</h2>
      <p class="text-slate-600 leading-relaxed max-w-3xl mb-10">
        BridgeAD is a product of Apqor Technologies Pvt Ltd , an engineering company based in Hyderabad, India. There is no reseller layer or outsourced support desk between you and the people who build the platform.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {trustPoints.map((point) => (
          <div class="p-6 rounded-2xl bg-white border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{point.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">FAQ</span>
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-10">Common questions.</h2>
