---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const homeEntry = await getEntry('pages', 'home');

const serviceCards = [
  {
    title: 'Cyber Security',
    href: '/cyber-security/',
    icon: '/assets/images/Screenshot-2026-01-24-140716.png',
    desc: 'Comprehensive protection for your digital assets with the Microsoft Security Stack and ISO 27001 standards.',
  },
  {
    title: 'Digital\nTransformation & AI',
    href: '/digital-transformation/',
    icon: '/assets/images/Screenshot-2026-01-24-140705.png',
    desc: 'Strategic innovation using Microsoft Dynamics 365, Power Platform, and AI-driven insights.',
  },
  {
    title: 'Cloud &\nInfrastructure',
    href: '/cloud-infrastructure/',
    icon: '/assets/images/Screenshot-2026-01-24-140651.png',
    desc: 'Secure, scalable Microsoft Azure solutions and modern infrastructure designed for enterprise resilience.',
  },
  {
    title: 'IT Support &\nManaged Services',
    href: '/it-support-managed-services/',
    icon: '/assets/images/Screenshot-2026-01-24-140546.png',
    desc: 'Proactive 24/7 monitoring and helpdesk support to keep your operations running smoothly.',
  },
];

const excellenceItems = [
  {
    title: 'Microsoft Solutions Partner for Digital & App Innovation',
    icon: 'partner',
  },
  {
    title: 'Dedicated support team available 24/7',
    icon: 'team',
  },
  {
    title: 'Proven methodology for digital transformation success',
    icon: 'methodology',
  },
  {
    title: 'ISO 27001 & Cyber Essentials Plus certified',
    icon: 'certified',
  },
  {
    title: 'Enterprise-grade security and compliance focus',
    icon: 'security',
  },
  {
    title: 'Nationwide coverage supporting remote & hybrid teams',
    icon: 'coverage',
  },
];

const sectorItems = [
  {
    title: 'SMBs & Growing Enterprises',
    icon: 'enterprise',
  },
  {
    title: 'Professional Services',
    icon: 'services',
  },
  {
    title: 'Remote & Hybrid Workforce',
    icon: 'remote',
  },
  {
    title: 'Technology & Innovation',
    icon: 'tech',
  },
];
---

<BaseLayout title={homeEntry?.data.title || 'Home'} description={homeEntry?.data.description}>
  <!-- Hero Section -->
  <section
    class="relative bg-cover bg-center text-white py-24 sm:py-28 lg:py-36 overflow-hidden flex items-center justify-center min-h-[520px]"
    style="background-image: url('/assets/images/image-23-scaled-1.png');"
  >
    <!-- Deep blue overlay matching the original brand aesthetic -->
    <div class="absolute inset-0 bg-[#255d88]/85 backdrop-blur-[0.5px]"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
      <h1
        class="text-3xl sm:text-5xl lg:text-[56px] font-bold text-white tracking-tight leading-[1.15] mb-5 max-w-4xl"
        style="font-family: 'Roboto Serif', Georgia, serif;"
      >
        A Trusted IT Partner for Secure,<br class="hidden sm:inline" /> Scalable Growth
      </h1>
      <p
        class="text-base sm:text-lg lg:text-[17px] text-white/95 max-w-3xl mx-auto mb-8 leading-relaxed font-normal"
        style="font-family: 'Roboto Serif', Georgia, serif;"
      >
        We deliver managed IT support, Microsoft cloud solutions, cyber security, and digital transformation helping organisations stay resilient, compliant, and ready for what’s next.
      </p>
      <div>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-[10px] text-base font-semibold bg-white text-[#0F69A5] hover:bg-slate-50 shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5"
          style="font-family: 'Roboto Serif', Georgia, serif;"
        >
          <span>Get In Touch</span>
          <svg class="w-4 h-4 fill-current transition-transform group-hover:translate-x-0.5" viewBox="0 0 448 512" aria-hidden="true">
            <path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Our Commitment / Strategic Technology Partner Section -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center max-w-4xl mx-auto mb-14 sm:mb-16">
        <p class="text-[#1D70B8] text-sm sm:text-base font-medium mb-3 tracking-normal">
          Our Commitment
        </p>
        <h2
          class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#104068] tracking-tight leading-tight mb-5"
          style="font-family: 'Roboto Serif', Georgia, serif;"
        >
          Your Strategic Technology Partner
        </h2>
        <p class="text-slate-600 text-base sm:text-[17px] leading-relaxed max-w-4xl mx-auto font-normal">
          We deliver enterprise-grade IT solutions that drive efficiency, security, and sustainable growth. As a Microsoft Solutions Partner, we combine technical excellence with a deep understanding of the business landscape to help you navigate an increasingly complex digital world.
        </p>
      </div>

      <!-- 4 Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {serviceCards.map((card) => (
          <a
            href={card.href}
            class="group bg-white rounded-2xl p-6 sm:p-7 border border-slate-100 shadow-[0_10px_30px_rgba(0,0,0,0.08)] hover:shadow-[0_16px_36px_rgba(0,0,0,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-start text-left"
          >
            <div class="mb-6 flex-shrink-0">
              <img src={card.icon} alt="" class="w-14 h-14 object-contain" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#104068] transition-colors mb-4 leading-snug min-h-[3.25rem] flex items-start whitespace-pre-line">
              {card.title}
            </h3>
            <p class="text-slate-500 text-[14.5px] leading-relaxed font-normal">
              {card.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 1: Why Partner With Us / Excellence in Delivery -->
  <section class="py-20 lg:py-28 bg-[#f8fafc] border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
        <p class="text-[#1D70B8] text-sm sm:text-base font-medium mb-3">
          Why Partner With Us
        </p>
        <h2
          class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#104068] tracking-tight"
          style="font-family: 'Roboto Serif', Georgia, serif;"
        >
          Excellence in Delivery
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {excellenceItems.map((item) => (
          <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-[0_4px_20px_rgba(0,0,0,0.04)] border border-slate-100/80 flex items-center gap-5 hover:shadow-md transition-shadow duration-200">
            {item.icon === 'partner' && (
              <svg class="w-8 h-8 text-[#104068] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M8.5 12.5l2.5 2.5 5-5" />
              </svg>
            )}
            {item.icon === 'team' && (
              <svg class="w-8 h-8 text-[#104068] flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
              </svg>
            )}
            {item.icon === 'methodology' && (
              <svg class="w-8 h-8 text-[#104068] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18" />
                <path d="M7 14l4-4 4 4 5-6" />
                <path d="M16 8h4v4" />
              </svg>
            )}
            {item.icon === 'certified' && (
              <svg class="w-8 h-8 text-[#104068] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8.5" r="5.5" />
                <path d="M8.2 13.5L7 21l5-2.5 5 2.5-1.2-7.5" />
              </svg>
            )}
            {item.icon === 'security' && (
              <svg class="w-8 h-8 text-[#104068] flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3z" />
              </svg>
            )}
            {item.icon === 'coverage' && (
              <svg class="w-8 h-8 text-[#104068] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9.5" />
                <path d="M2.5 12h19" />
                <path d="M12 2.5c2.5 3 4 6.5 4 9.5s-1.5 6.5-4 9.5c-2.5-3-4-6.5-4-9.5s1.5-6.5 4-9.5z" />
                <path d="M4 7.5h16M4 16.5h16" />
              </svg>
            )}
            <span class="text-slate-800 font-medium text-[15px] sm:text-[15.5px] leading-snug">
              {item.title}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Sectors / Industries We Serve -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
        <p class="text-[#1D70B8] text-sm sm:text-base font-medium mb-3">
          Sectors
        </p>
        <h2
          class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#104068] tracking-tight mb-4"
          style="font-family: 'Roboto Serif', Georgia, serif;"
        >
          Industries We Serve
        </h2>
        <p class="text-slate-500 text-base sm:text-[17px] font-normal">
          Tailored technology solutions for diverse business sectors
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {sectorItems.map((sector) => (
          <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-[0_10px_30px_rgba(0,0,0,0.06)] hover:shadow-[0_16px_36px_rgba(0,0,0,0.1)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center justify-center min-h-[220px]">
            <div class="w-20 h-20 rounded-full border border-sky-300 flex items-center justify-center mb-6 bg-white flex-shrink-0">
              {sector.icon === 'enterprise' && (
                <svg class="w-9 h-9 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17 2H7a2 2 0 00-2 2v17a1 1 0 001 1h12a1 1 0 001-1V4a2 2 0 00-2-2zM9 6h2v2H9V6zm0 4h2v2H9v-2zm0 4h2v2H9v-2zm6 4h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V6h2v2z"/>
                </svg>
              )}
              {sector.icon === 'services' && (
                <svg class="w-9 h-9 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20 6h-4V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10-2h4v2h-4V4zm10 15H4v-7h6v2h4v-2h6v7zm0-9h-5v1h-2v-1H4V8h16v2z"/>
                </svg>
              )}
              {sector.icon === 'remote' && (
                <svg class="w-9 h-9 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 3L2 12h3v8h14v-8h3L12 3zm0 4.5c1.38 0 2.5 1.12 2.5 2.5s-1.12 2.5-2.5 2.5S9.5 11.38 9.5 10 10.62 7.5 12 7.5zm4 10.5H8v-1.5c0-1.33 2.67-2 4-2s4 .67 4 2v1.5z"/>
                </svg>
              )}
              {sector.icon === 'tech' && (
                <svg class="w-9 h-9 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20 3H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h6v2H8v2h8v-2h-2v-2h6c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 12H4V5h16v10zM9 7.5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5S7.5 9.83 7.5 9 8.17 7.5 9 7.5zm2.5 6.5h-5v-1c0-.83 1.67-1.25 2.5-1.25s2.5.42 2.5 1.25v1zm6.5-1.5h-4v-1.5h4v1.5zm0-3h-4V8h4v1.5z"/>
                </svg>
              )}
            </div>
            <h3 class="text-[#104068] font-bold text-base sm:text-[17px] leading-snug">
              {sector.title}
            </h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: CTA / Ready to Modernise Your IT Environment? -->
  <section class="py-20 lg:py-24 bg-[#0e4f85] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2
        class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-white tracking-tight leading-tight mb-5"
        style="font-family: 'Roboto Serif', Georgia, serif;"
      >
        Ready to Modernise Your IT Environment?
      </h2>
      <p class="text-white/95 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto mb-10 font-normal">
        Let's discuss how Prana Solutions can transform your business operations, enhance security, and drive sustainable growth for your organisation.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5">
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-7 py-3 rounded-[10px] text-base font-semibold bg-white text-[#0e4f85] hover:bg-slate-50 shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5"
        >
          <span>Get Started Today</span>
          <svg class="w-4 h-4 fill-current transition-transform group-hover:translate-x-0.5" viewBox="0 0 448 512" aria-hidden="true">
            <path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z"/>
          </svg>
        </a>
        <a
          href="/case-studies/"
          class="inline-flex items-center justify-center px-7 py-3 rounded-[10px] text-base font-semibold bg-transparent text-white border-2 border-white hover:bg-white/10 transition-all duration-200 transform hover:-translate-y-0.5"
        >
          View Case Studies
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
