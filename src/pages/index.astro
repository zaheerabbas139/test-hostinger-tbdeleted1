---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const homeEntry = await getEntry('pages', 'home');
const { Content } = homeEntry ? await homeEntry.render() : { Content: null };

const serviceHighlights = [
  {
    title: 'Cyber Security',
    href: '/cyber-security',
    icon: '/assets/images/Screenshot-2026-01-24-140716.png',
    desc: 'Comprehensive protection for your digital assets with the Microsoft Security Stack, ISO 27001 standards, and Zero Trust architecture.',
  },
  {
    title: 'Digital Transformation & AI',
    href: '/digital-transformation',
    icon: '/assets/images/Screenshot-2026-01-24-140705.png',
    desc: 'Strategic business process automation and data intelligence using Microsoft Dynamics 365, Power Platform, and AI-driven workflows.',
  },
  {
    title: 'Cloud & Infrastructure',
    href: '/cloud-infrastructure',
    icon: '/assets/images/Screenshot-2026-01-24-140651.png',
    desc: 'Secure, scalable Microsoft Azure solutions and modernized cloud infrastructure designed for resilient, always-available enterprise workloads.',
  },
  {
    title: 'IT Support & Managed Services',
    href: '/it-support-managed-services',
    icon: '/assets/images/Screenshot-2026-01-24-140546.png',
    desc: 'Proactive 24/7 monitoring, rapid helpdesk resolution, and ITIL-aligned service level agreements to keep your operations running smoothly.',
  },
];
---

<BaseLayout title={homeEntry?.data.title || 'Home'} description={homeEntry?.data.description}>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-24 lg:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-500/30 mb-6">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          Microsoft Solutions Partner
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-6">
          A Trusted IT Partner for <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-300">Secure, Scalable Growth</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 mb-8 leading-relaxed">
          We deliver managed IT support, Microsoft cloud solutions, cyber security, and digital transformation helping organisations stay resilient, compliant, and ready for what’s next.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-8 py-3.5 rounded-lg text-sm font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition transform hover:-translate-y-0.5"
          >
            Get In Touch
          </a>
          <a
            href="/who-we-are"
            class="px-8 py-3.5 rounded-lg text-sm font-semibold bg-white/10 hover:bg-white/20 text-white border border-white/20 transition"
          >
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Pillars Section -->
  <section id="services" class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-blue-600 mb-2">Our Capabilities</h2>
        <p class="text-3xl font-extrabold text-slate-900 tracking-tight">Enterprise IT Solutions Built for Scale</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {serviceHighlights.map((svc) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition flex flex-col justify-between group">
            <div>
              <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center mb-6 group-hover:scale-105 transition">
                <img src={svc.icon} alt="" class="w-8 h-8 object-contain" />
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition">
                <a href={svc.href}>{svc.title}</a>
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-6">
                {svc.desc}
              </p>
            </div>
            <a href={svc.href} class="text-sm font-semibold text-blue-600 hover:text-blue-700 inline-flex items-center gap-1 group-hover:gap-2 transition">
              Explore service <span>&rarr;</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Extracted Page Content Section -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      {Content ? (
        <article class="prose max-w-none">
          <Content />
        </article>
      ) : (
        <p>Content loading...</p>
      )}
    </div>
  </section>

  <!-- Interactive Contact CTA Section -->
  <section class="py-20 bg-slate-100 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5">
          <span class="text-xs font-bold uppercase tracking-widest text-blue-600 mb-2 block">Take the Next Step</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
            Accelerate Your Digital Transformation
          </h2>
          <p class="text-slate-600 leading-relaxed mb-6">
            Whether you are looking to secure your Microsoft 365 environment, migrate legacy workloads to Azure, or modernize business processes, our solutions architects are ready to assist.
          </p>
          <ul class="space-y-3 text-sm text-slate-700">
            <li class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs">&check;</span>
              Complimentary IT & Cloud Readiness Assessment
            </li>
            <li class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs">&check;</span>
              Direct Access to Certified Microsoft Solutions Architects
            </li>
            <li class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs">&check;</span>
              Customized Modernization Roadmap & Cost Optimization
            </li>
          </ul>
        </div>
        <div class="lg:col-span-7">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

