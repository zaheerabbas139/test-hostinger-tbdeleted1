---
/**
 * FaqAccordion.astro
 * Plain FAQ accordion: optional category headings, one <details> per question,
 * and Schema.org FAQPage JSON-LD for search engines. No search or filter UI.
 */

export interface FaqItem {
  question: string;
  answer: string;
}

export interface FaqGroup {
  heading?: string;
  items: FaqItem[];
}

export interface Props {
  groups: FaqGroup[];
}

const { groups } = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  ),
};
---

<div class="faq-accordion-component">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  {groups.map((group) => (
    <section class="mb-12 last:mb-0">
      {group.heading && (
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight border-b border-slate-100 pb-2 mb-6">{group.heading}</h2>
      )}
      <div class="space-y-4">
        {group.items.map((item) => (
          <details class="group bg-white rounded-2xl border border-slate-200/90 shadow-sm transition hover:border-blue-300 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer select-none list-none font-bold text-slate-900 text-base sm:text-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
              <span class="group-hover:text-blue-600 transition leading-snug">{item.question}</span>
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-50 text-slate-500 group-hover:bg-blue-50 group-hover:text-blue-600 flex items-center justify-center transition" aria-hidden="true">
                <svg class="w-4 h-4 transform group-open:rotate-180 transition duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="px-5 sm:px-6 pb-6 pt-1 text-slate-600 text-sm sm:text-base leading-relaxed border-t border-slate-100 bg-slate-50/40">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  ))}
</div>
