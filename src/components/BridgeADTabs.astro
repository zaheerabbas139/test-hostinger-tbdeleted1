---
/**
 * BridgeADTabs.astro
 * Interactive Product Showcase Tabs for BridgeAD Intelligence & Cloud Workloads
 * Zero-dependency, accessible (WAI-ARIA tablist pattern) with keyboard navigation
 */

interface TabData {
  id: string;
  name: string;
  tagline: string;
  badge: string;
  description: string;
  image: string;
  imageAlt: string;
  highlights: {
    title: string;
    description: string;
    icon: string;
  }[];
  metrics: {
    value: string;
    label: string;
  }[];
}

const tabs: TabData[] = [
  {
    id: 'intelligence',
    name: 'BridgeAD Intelligence',
    tagline: 'Cloud Estate Assessment, Target Design & Governed Verification',
    badge: 'Assessment & Governance',
    description:
      'Deep estate discovery across Active Directory, Microsoft Entra ID, Azure, and AWS workloads. BridgeAD Intelligence baseline-scores identity health, maps dependencies, uncovers collisions, and generates hash-chain verifiable audit evidence before a single byte moves.',
    image: '/assets/images/intelligence-dashboard.webp',
    imageAlt: 'BridgeAD Intelligence migration assessment dashboard preview',
    highlights: [
      {
        title: 'Cloud Decision Modeling',
        description: 'Automated estate assessment, gap analysis, target sizing, and dependency mapping with cited architectural recommendations.',
        icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
      },
      {
        title: 'Migration Intelligence & Telemetry',
        description: 'Real-time discovery insights, failure root-cause classification, and automated remediation pathways with exact claim references.',
        icon: 'M13 10V3L4 14h7v7l9-11h-7z',
      },
      {
        title: 'Cryptographic Audit & Custody',
        description: 'Immutable hash-chain verification, correlation IDs, operator role traceability, and verifiable compliance sign-off certificates.',
        icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
      },
      {
        title: 'Claim Discipline Framework',
        description: 'Every public capability and recommendation maps to an audited claim ledger and verified test boundary rather than sales promises.',
        icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
      },
    ],
    metrics: [
      { value: '60%', label: 'Faster Pre-Flight Scoping' },
      { value: '100%', label: 'Auditable Evidence Chain' },
      { value: 'Zero', label: 'Unmapped Identity Surprises' },
    ],
  },
  {
    id: 'workloads',
    name: 'BridgeAD Cloud Workloads',
    tagline: 'High-Throughput Execution Engines for Identity & Microsoft 365',
    badge: 'Execution & Cutover',
    description:
      'High-throughput migration engines purpose-built for complex Active Directory and Microsoft 365 migrations. Orchestrate users, groups, permissions, any-to-any mailboxes, SharePoint, OneDrive, and Teams with dry runs, live pause/resume, and per-step rollback protection.',
    image: '/assets/images/cloud-workloads-dashboard.webp',
    imageAlt: 'BridgeAD Cloud Workloads execution telemetry dashboard preview',
    highlights: [
      {
        title: 'Active Directory & Entra ID',
        description: 'Topology-aware discovery, CSV workflow mapping, collision checks, dry-run simulations, SID history preservation, and ACL remapping.',
        icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
      },
      {
        title: 'Certified Any-to-Any Mailbox Routes',
        description: 'Resumable delta passes across Exchange Online, Google Workspace / Gmail, IMAP hosts, on-premises Exchange (EWS), and PST/EML archives.',
        icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
      },
      {
        title: 'SharePoint & OneDrive Scoping',
        description: 'Resumable Graph-driven content transfer with configurable version depth, permission preservation, list migration, and reconciliation.',
        icon: 'M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7zm0 4h16',
      },
      {
        title: 'Teams & Collaboration Reconstruction',
        description: 'Graph-based team structure, channel mapping, tabs, tags, and memberships with conditional Microsoft-protected-API message fidelity.',
        icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
      },
    ],
    metrics: [
      { value: '5+', label: 'Certified Mailbox Routes' },
      { value: 'Per-Step', label: 'Rollback & Circuit Breakers' },
      { value: '0 Bytes', label: 'Customer Data Retained at Rest' },
