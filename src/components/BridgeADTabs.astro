---

<div class="bridgead-showcase bg-white rounded-3xl border border-slate-200/90 shadow-xl overflow-hidden" data-tabs-root>
  <!-- Tab Header Navigation (WAI-ARIA compliant tablist) -->
  <div class="bg-slate-900/95 p-4 sm:p-6 border-b border-slate-800">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-blue-400">Interactive Product Tour</span>
        <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Two Specialized Migration Engines</h3>
      </div>
      <div
        class="inline-flex p-1.5 rounded-xl bg-slate-800/90 border border-slate-700/80 self-start sm:self-center"
        role="tablist"
        aria-label="BridgeAD Product Showcase Engines"
      >
        {tabs.map((tab, idx) => (
          <button
            type="button"
            role="tab"
            id={`tab-btn-${tab.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`tab-panel-${tab.id}`}
            tabindex={idx === 0 ? 0 : -1}
            data-tab-target={tab.id}
            class:list={[
              'px-5 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 flex items-center gap-2',
              idx === 0
                ? 'bg-blue-600 text-white shadow-md shadow-blue-600/30'
                : 'text-slate-300 hover:text-white hover:bg-slate-700/50',
            ]}
          >
            <span class={`w-2 h-2 rounded-full ${idx === 0 ? 'bg-blue-300' : 'bg-slate-500'}`}></span>
            {tab.name.replace('BridgeAD ', '')}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Tab Panels Container -->
  <div class="p-6 sm:p-8 lg:p-10">
    {tabs.map((tab, idx) => (
      <div
        id={`tab-panel-${tab.id}`}
        role="tabpanel"
        aria-labelledby={`tab-btn-${tab.id}`}
        data-tab-panel={tab.id}
        class:list={['transition-opacity duration-300', idx === 0 ? 'block opacity-100' : 'hidden opacity-0']}
      >
        <!-- Panel Header -->
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
            {tab.badge}
          </div>
          <h4 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
            {tab.name}: <span class="text-blue-600 font-semibold">{tab.tagline}</span>
          </h4>
          <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-4xl">
            {tab.description}
          </p>
        </div>

        <!-- Metrics Strip -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10 p-5 rounded-2xl bg-slate-50 border border-slate-200/80">
          {tab.metrics.map((metric) => (
            <div class="text-center sm:text-left border-b sm:border-b-0 sm:border-r border-slate-200 last:border-0 pb-3 sm:pb-0 sm:pr-4">
              <div class="text-2xl sm:text-3xl font-extrabold text-blue-600 tracking-tight">{metric.value}</div>
              <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mt-1">{metric.label}</div>
            </div>
          ))}
        </div>

        <!-- Interactive Split Grid: Screenshot Preview + Capabilities List -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Screenshot Preview with interactive zoom indicator -->
          <div class="lg:col-span-7">
            <div class="group relative rounded-2xl overflow-hidden border border-slate-200 shadow-md bg-slate-950 transition hover:shadow-xl">
              <div class="flex items-center justify-between px-4 py-2.5 bg-slate-900 border-b border-slate-800 text-xs text-slate-400">
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                  <span class="ml-2 font-mono text-[11px] text-slate-300">{tab.name.toLowerCase().replace(/\s+/g, '-')}-live-telemetry</span>
                </div>
                <span class="text-[11px] font-mono bg-blue-500/20 text-blue-300 px-2 py-0.5 rounded">Live Console</span>
              </div>
              <div class="relative overflow-hidden bg-slate-900">
                <img
                  src={tab.image}
                  alt={tab.imageAlt}
                  loading="lazy"
                  class="w-full h-auto object-cover transform group-hover:scale-[1.02] transition duration-500"
                />
              </div>
              <div class="p-3 bg-slate-900/95 border-t border-slate-800 text-xs text-slate-400 flex items-center justify-between">
                <span>Production Console Preview &bull; {tab.name}</span>
                <span class="text-slate-500 text-[11px]">Hover to inspect telemetry view</span>
              </div>
            </div>
          </div>

          <!-- Feature Highlights List -->
          <div class="lg:col-span-5 space-y-4">
            <h5 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Core Architectural Capabilities</h5>
            {tab.highlights.map((item) => (
              <div class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/80 hover:bg-white hover:border-blue-300 hover:shadow-sm transition group">
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                    </svg>
                  </div>
                  <div>
                    <h6 class="text-sm font-bold text-slate-900 mb-1 group-hover:text-blue-600 transition">
                      {item.title}
                    </h6>
                    <p class="text-xs text-slate-600 leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Bottom Action Bar -->
        <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-sm text-slate-500 flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Production-ready deployment &bull; Azure SaaS or Customer-Managed Self-Hosted</span>
          </div>
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <a
              href="/contact"
              class="w-full sm:w-auto text-center px-6 py-2.5 rounded-lg text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-sm transition"
            >
              Request {tab.name.replace('BridgeAD ', '')} Demo
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  // Progressive enhancement: Accessible tab switching with keyboard navigation
  function setupBridgeADTabs() {
    const root = document.querySelector('[data-tabs-root]');
    if (!root) return;

    const tabButtons = root.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    const tabPanels = root.querySelectorAll<HTMLElement>('[role="tabpanel"]');

    function switchTab(targetId: string) {
      tabButtons.forEach((btn) => {
        const isMatch = btn.getAttribute('data-tab-target') === targetId;
        btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        btn.setAttribute('tabindex', isMatch ? '0' : '-1');

        if (isMatch) {
          btn.classList.add('bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-600/30');
          btn.classList.remove('text-slate-300', 'hover:text-white', 'hover:bg-slate-700/50');
          const indicator = btn.querySelector('span');
          if (indicator) {
            indicator.classList.remove('bg-slate-500');
            indicator.classList.add('bg-blue-300');
          }
        } else {
          btn.classList.remove('bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-600/30');
          btn.classList.add('text-slate-300', 'hover:text-white', 'hover:bg-slate-700/50');
          const indicator = btn.querySelector('span');
          if (indicator) {
            indicator.classList.remove('bg-blue-300');
            indicator.classList.add('bg-slate-500');
          }
        }
      });

      tabPanels.forEach((panel) => {
        const isMatch = panel.getAttribute('data-tab-panel') === targetId;
        if (isMatch) {
          panel.classList.remove('hidden');
          // Trigger slight fade-in
          setTimeout(() => {
            panel.classList.remove('opacity-0');
            panel.classList.add('opacity-100');
          }, 10);
        } else {
          panel.classList.add('hidden', 'opacity-0');
          panel.classList.remove('opacity-100');
        }
      });
    }

    tabButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab-target');
        if (targetId) switchTab(targetId);
      });

      // Keyboard navigation (WAI-ARIA pattern: ArrowLeft / ArrowRight)
      btn.addEventListener('keydown', (e) => {
        let newIndex: number | null = null;
        if (e.key === 'ArrowRight') {
          newIndex = (index + 1) % tabButtons.length;
        } else if (e.key === 'ArrowLeft') {
          newIndex = (index - 1 + tabButtons.length) % tabButtons.length;
        } else if (e.key === 'Home') {
          newIndex = 0;
        } else if (e.key === 'End') {
          newIndex = tabButtons.length - 1;
        }

        if (newIndex !== null) {
          e.preventDefault();
          const newBtn = tabButtons[newIndex];
          newBtn.focus();
          const targetId = newBtn.getAttribute('data-tab-target');
          if (targetId) switchTab(targetId);
        }
      });
    });
  }

  // Support both direct load and Astro client-side page transitions
  setupBridgeADTabs();
  document.addEventListener('astro:page-load', setupBridgeADTabs);
</script>

