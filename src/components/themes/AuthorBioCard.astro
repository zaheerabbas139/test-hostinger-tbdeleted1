---
import type { Author } from '../../data/authors';

interface Props {
  author: Author;
  variant?: 'sidebar' | 'inline';
  class?: string;
}

const { author, variant = 'sidebar', class: className = '' } = Astro.props;
---

{variant === 'sidebar' ? (
  <div class={`bg-stone-50/90 rounded-2xl p-6 border border-stone-200/90 shadow-xs ${className}`}>
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-stone-200/80">
      <span class="text-xs font-bold uppercase tracking-wider text-stone-700 font-sans">
        Author
      </span>
      <span class="text-xs text-emerald-800 font-semibold">Specialist</span>
    </div>
    <div class="flex items-center gap-4 mb-3">
      <img
        src={author.avatar}
        alt={author.name}
        width="64"
        height="64"
        class="w-14 h-14 rounded-full object-cover border border-stone-300 shadow-xs flex-shrink-0"
        loading="lazy"
        decoding="async"
      />
      <div>
        <h4 class="font-serif font-bold text-stone-900 text-base leading-tight">
          {author.name}
        </h4>
        <p class="text-xs text-stone-600 mt-1">Solution Specialist</p>
      </div>
    </div>
    <p class="text-xs text-stone-600 leading-relaxed font-sans mb-4">
      {author.bio}
    </p>
    <a
      href="/blog/"
      class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 inline-flex items-center gap-1 group transition"
    >
      <span>Browse all articles</span>
      <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
    </a>
  </div>
) : (
  <div class={`rounded-2xl bg-stone-50/90 border border-stone-200/90 p-6 sm:p-8 shadow-xs ${className}`}>
    <div class="flex flex-col sm:flex-row gap-6 items-start">
      <img
        src={author.avatar}
        alt={author.name}
        width="96"
        height="96"
        class="w-20 h-20 rounded-full object-cover border border-stone-300 shadow-xs flex-shrink-0"
        loading="lazy"
        decoding="async"
      />
      <div class="flex-grow">
        <div class="flex items-center gap-3 mb-1">
          <h4 class="font-serif font-bold text-lg sm:text-xl text-stone-900">
            {author.name}
          </h4>
          <span class="px-2 py-0.5 rounded text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
            Author
          </span>
        </div>
        <p class="text-sm text-stone-600 leading-relaxed font-sans mb-4 mt-2">
          {author.bio}
        </p>
        <a
          href="/blog/"
          class="text-sm font-semibold text-emerald-800 hover:text-emerald-950 inline-flex items-center gap-1 group transition"
        >
          <span>More insights by {author.name}</span>
          <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
)}

