---
interface Props {
  targetSelector?: string;
  class?: string;
}

const { targetSelector = 'article', class: className = '' } = Astro.props;
---

<!-- Reading Progress Bar (Fixed Top) -->
<div
  id="reading-progress-container"
  class={`fixed top-0 left-0 right-0 z-50 h-1 bg-transparent pointer-events-none ${className}`}
  role="progressbar"
  aria-label="Reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <div
    id="reading-progress-bar"
    class="h-full w-0 bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400 transition-[width] duration-75 ease-out shadow-xs shadow-indigo-500/50"
  ></div>
</div>

<script define:vars={{ targetSelector }}>
  function initReadingProgress() {
    const progressBar = document.getElementById('reading-progress-bar');
    const progressContainer = document.getElementById('reading-progress-container');
    if (!progressBar || !progressContainer) return;

    let ticking = false;

    function updateProgress() {
      const targetElement = document.querySelector(targetSelector) || document.documentElement;
      const targetRect = targetElement.getBoundingClientRect();
      const targetTop = window.scrollY + targetRect.top;
      const targetHeight = targetElement.scrollHeight || targetElement.clientHeight;
      const windowHeight = window.innerHeight;

      const scrollDistance = window.scrollY - targetTop;
      const maxScrollable = targetHeight - windowHeight;

      let progress = 0;
      if (maxScrollable > 0) {
        progress = Math.min(100, Math.max(0, (scrollDistance / maxScrollable) * 100));
      } else {
        const docHeight = document.documentElement.scrollHeight - windowHeight;
        progress = docHeight > 0 ? Math.min(100, Math.max(0, (window.scrollY / docHeight) * 100)) : 0;
      }

      progressBar.style.width = `${progress}%`;
      progressContainer.setAttribute('aria-valuenow', Math.round(progress).toString());
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateProgress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReadingProgress);
  } else {
    initReadingProgress();
  }
</script>

