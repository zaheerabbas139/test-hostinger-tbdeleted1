---
/**
 * WorkloadReadinessMatrix.astro
 * Interactive Filterable Capability & Readiness Matrix for BridgeAD
 * Replaces unstyled legacy HTML/CSS tables with a responsive, searchable grid.
 */

interface CapabilityItem {
  id: string;
  name: string;
  category: 'Identity & Directory' | 'Mail & Messaging' | 'Content & Collaboration' | 'Infrastructure & Endpoints';
  status: 'Supported' | 'Conditional';
  boundary: string;
}

const capabilities: CapabilityItem[] = [
  {
    id: 'ad-discovery',
    name: 'AD discovery, mapping, CSV validation, and dry run',
    category: 'Identity & Directory',
    status: 'Supported',
    boundary: 'Available for orchestrating when connections and permissions validate. Full topology discovery with schema comparison.',
  },
  {
    id: 'ad-orchestration',
    name: 'AD migration orchestration and rollback',
    category: 'Identity & Directory',
    status: 'Supported',
    boundary: 'Dry-run first with verified success criteria; per-step rollback, automated rollback rules, and connectivity circuit breakers built in.',
  },
  {
    id: 'sid-history',
    name: 'SID history and ACL remapping',
    category: 'Identity & Directory',
    status: 'Supported',
    boundary: 'Agent-executed with streamed progress and cryptographic evidence; multi-forest translation follows applied sync and mapped peer links.',
  },
  {
    id: 'entra-objects',
    name: 'Entra users, groups, devices, and memberships',
    category: 'Identity & Directory',
    status: 'Supported',
    boundary: 'Configured Graph permissions required; synchronized hybrid attributes remain owned by Entra Connect or Cloud Sync.',
  },
  {
    id: 'entra-t2t',
    name: 'Entra tenant-to-tenant users and static groups',
    category: 'Identity & Directory',
    status: 'Supported',
    boundary: 'Preview-first route with UPN transformation, optional update-existing reruns, and membership reconciliation; licenses, mailboxes, and MFA registration remain separate.',
  },
  {
    id: 'google-directory',
    name: 'Google Workspace directory to Entra or AD',
    category: 'Identity & Directory',
    status: 'Supported',
    boundary: 'Users and groups migration via Google domain-wide delegation; Gmail, Drive, Calendar, and source passwords move via workload engines.',
  },
  {
    id: 'device-conversion',
    name: 'Cloud-native device conversion',
    category: 'Infrastructure & Endpoints',
    status: 'Supported',
    boundary: 'AD unjoin, Entra join, Microsoft 365 app reset, and BitLocker escrow verification — dry-run first, using customer provisioning packages and SYSTEM agent.',
  },
  {
    id: 'iis-sql',
    name: 'IIS and SQL Server migration',
    category: 'Infrastructure & Endpoints',
    status: 'Supported',
    boundary: 'Agent-executed configuration and credential moves with preview and confirmation gates; TLS keys, TDE prerequisites, and break-glass secrets remain explicit boundary items.',
  },
  {
    id: 'exchange-mailbox',
    name: 'Exchange Online mailbox content & cutover evidence',
    category: 'Mail & Messaging',
    status: 'Supported',
    boundary: 'Microsoft 365 tenant-to-tenant Graph path plus certified any-to-any routes (Gmail, IMAP, EWS, archives); in-place archives and public folders migrate via certified EWS route.',
  },
  {
    id: 'sharepoint-onedrive',
    name: 'SharePoint, OneDrive, and supported list content',
    category: 'Content & Collaboration',
    status: 'Supported',
    boundary: 'Scoped Graph transfer; configurable version depth, permission preservation, and list reconciliation. Complex custom third-party SPFx apps remain manual.',
  },
  {
    id: 'teams-structure',
    name: 'Teams structure, membership, settings, tabs, and tags',
    category: 'Content & Collaboration',
    status: 'Supported',
    boundary: 'Graph reconstruction of team architectures; files and meetings migrate through their underlying SharePoint/Exchange workload engines.',
  },
  {
    id: 'teams-messages',
    name: 'Teams channel messages and private 1:1 chats',
    category: 'Content & Collaboration',
    status: 'Conditional',
    boundary: 'Requires Microsoft-protected-API approval and opt-in migration mode; attachments move through SharePoint; 1:1 chat shells use transport via destination OneDrive.',
  },
];

const totalSupported = capabilities.filter((c) => c.status === 'Supported').length;
const totalConditional = capabilities.filter((c) => c.status === 'Conditional').length;
---

<div class="workload-matrix" data-matrix-root>
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">Workload Readiness Directory</span>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Engine Capabilities & Technical Delivery Boundaries
      </h3>
      <p class="text-slate-600 text-sm mt-1 max-w-2xl">
        Every capability statement maps to verified production boundaries. Filter by status or search specific workloads below.
      </p>
    </div>

    <!-- Search Input -->
    <div class="relative w-full md:w-72">
      <input
        type="text"
        placeholder="Filter capability (e.g. Teams, AD)..."
        data-matrix-search
        class="w-full pl-9 pr-4 py-2 text-xs rounded-xl border border-slate-200 bg-white text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm"
        aria-label="Filter capabilities"
      />
      <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <!-- Filter Pills -->
  <div class="flex flex-wrap items-center gap-2 mb-6" data-matrix-filters>
    <button
      type="button"
      data-filter="all"
      class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 text-white shadow-sm transition active-filter"
    >
      All Capabilities ({capabilities.length})
    </button>
    <button
      type="button"
      data-filter="Supported"
      class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
    >
      Supported ({totalSupported})
    </button>
    <button
      type="button"
      data-filter="Conditional"
      class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
    >
      Conditional ({totalConditional})
    </button>
  </div>

  <!-- Responsive Capability Table -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse" data-capability-table>
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-700 uppercase tracking-wider">
            <th class="py-3.5 px-4 sm:px-6 w-5/12">Capability & Domain</th>
            <th class="py-3.5 px-4 w-2/12">Status</th>
            <th class="py-3.5 px-4 sm:px-6 w-5/12">Delivery Boundary & Prerequisites</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-xs sm:text-sm">
          {capabilities.map((item) => (
            <tr
              class="hover:bg-slate-50/80 transition capability-row"
              data-capability-row
              data-status={item.status}
              data-text={`${item.name} ${item.category} ${item.boundary}`.toLowerCase()}
            >
              <td class="py-4 px-4 sm:px-6 align-top">
                <div class="font-bold text-slate-900 mb-1">{item.name}</div>
                <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                  {item.category}
                </span>
              </td>
              <td class="py-4 px-4 align-top">
                {item.status === 'Supported' ? (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    Supported
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    Conditional
                  </span>
                )}
              </td>
              <td class="py-4 px-4 sm:px-6 text-slate-600 leading-relaxed align-top">
                {item.boundary}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div class="hidden p-8 text-center" data-matrix-empty>
      <p class="text-sm text-slate-500">No capabilities match your current search or filter criteria.</p>
    </div>
  </div>
</div>

<script>
  function setupMatrixFilters() {
    const root = document.querySelector('[data-matrix-root]');
    if (!root) return;

    const searchInput = root.querySelector<HTMLInputElement>('[data-matrix-search]');
    const filterButtons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const rows = root.querySelectorAll<HTMLTableRowElement>('[data-capability-row]');
    const emptyState = root.querySelector<HTMLElement>('[data-matrix-empty]');

    let activeFilter = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;

      rows.forEach((row) => {
        const rowStatus = row.getAttribute('data-status') || '';
        const rowText = row.getAttribute('data-text') || '';

        const matchesStatus = activeFilter === 'all' || rowStatus === activeFilter;
        const matchesSearch = !searchQuery || rowText.includes(searchQuery);

        if (matchesStatus && matchesSearch) {
          row.classList.remove('hidden');
          visibleCount++;
        } else {
          row.classList.add('hidden');
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.getAttribute('data-filter') || 'all';

        filterButtons.forEach((b) => {
          b.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        applyFilters();
      });
    }
  }

  setupMatrixFilters();
  document.addEventListener('astro:page-load', setupMatrixFilters);
</script>

