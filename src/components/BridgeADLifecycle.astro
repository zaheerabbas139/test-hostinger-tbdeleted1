---
/**
 * BridgeADLifecycle.astro
 * Interactive 5-Stage Migration Control Loop ("Inside the Application")
 * Visual stepper + detailed operational execution gates
 */

const stages = [
  {
    step: '01',
    name: 'Select',
    tagline: 'Scope & Connection Binding',
    description: 'Choose validated source and destination connections, execution agents, assessed directory objects, users, sites, mailboxes, or servers.',
    gates: ['Agent Heartbeat Validation', 'Graph API Permission Check', 'Scope Boundary Ledger'],
    icon: 'M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122',
  },
  {
    step: '02',
    name: 'Preview',
    tagline: 'Dry-Run Readiness & Collision Checks',
    description: 'Run pre-flight dry-run simulations, inspect name/UPN collisions, evaluate SID history prerequisites, and revise mappings before any writes begin.',
    gates: ['Zero-Write Simulation', 'UPN Collision Detection', 'Schema Delta Mapping'],
    icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
  },
  {
    step: '03',
    name: 'Start',
    tagline: 'Bounded Wave Execution',
    description: 'Launch a migration wave, cloud-directory sync run, endpoint conversion, or server job with strict runtime options and circuit-breaker rules.',
    gates: ['Target Throttling Limits', 'Worker Pool Allocation', 'Rollback Point Registration'],
    icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    step: '04',
    name: 'Control',
    tagline: 'Real-Time Telemetry & Interventions',
    description: 'Monitor live item processing, warning indicators, and throughput meters. Pause, resume, cancel, or retry failed items with zero state loss.',
    gates: ['Live SignalR Dashboards', 'Item-Level Retry Logic', 'Automatic Circuit Breakers'],
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  },
  {
    step: '05',
    name: 'Prove',
    tagline: 'Cryptographic Custody & Sign-Off',
    description: 'Review reconciliation reports, record stakeholder acceptance, and export immutable hash-chain audit logs, transcripts, and completion certificates.',
    gates: ['Hash-Chain Verification', 'Exportable PDF/CSV Evidence', 'Sign-off Acceptance Record'],
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
];
---

<div class="bridgead-lifecycle" data-lifecycle-root>
  <div class="text-center max-w-3xl mx-auto mb-12">
    <span class="text-xs font-bold uppercase tracking-widest text-blue-600 mb-2 block">Operational Governance</span>
    <h3 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
      From Connection Selection to Signed-Off Evidence
    </h3>
    <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
      BridgeAD replaces opaque migration scripts with a disciplined 5-stage operational control loop. Every operator action is bounded, previewed, logged, and verifiable.
    </p>
  </div>

  <!-- Stage Navigation Stepper (Desktop & Mobile) -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-8" role="tablist" aria-label="Migration Lifecycle Stages">
    {stages.map((stage, idx) => (
      <button
        type="button"
        role="tab"
        id={`stage-tab-${stage.step}`}
        aria-selected={idx === 0 ? 'true' : 'false'}
        aria-controls={`stage-panel-${stage.step}`}
        data-stage-target={stage.step}
        class:list={[
          'p-4 rounded-2xl text-left border transition-all duration-200 group',
          idx === 0
            ? 'bg-blue-600 text-white border-blue-600 shadow-lg shadow-blue-600/20'
            : 'bg-white text-slate-700 border-slate-200 hover:border-blue-300 hover:bg-slate-50',
        ]}
      >
        <div class="flex items-center justify-between mb-2">
          <span class:list={['text-xs font-mono font-bold px-2 py-0.5 rounded', idx === 0 ? 'bg-blue-500/40 text-blue-100' : 'bg-slate-100 text-slate-500 group-hover:bg-blue-50 group-hover:text-blue-600']}>
            {stage.step}
          </span>
          <svg class:list={['w-4 h-4', idx === 0 ? 'text-blue-200' : 'text-slate-400 group-hover:text-blue-600']} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stage.icon} />
          </svg>
        </div>
        <div class:list={['text-base font-bold tracking-tight', idx === 0 ? 'text-white' : 'text-slate-900']}>
          {stage.name}
        </div>
        <div class:list={['text-[11px] truncate mt-0.5', idx === 0 ? 'text-blue-100' : 'text-slate-500']}>
          {stage.tagline}
        </div>
      </button>
    ))}
  </div>

  <!-- Active Stage Detailed Card -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 rounded-3xl p-6 sm:p-10 text-white border border-slate-800 shadow-xl">
    {stages.map((stage, idx) => (
      <div
        id={`stage-panel-${stage.step}`}
        role="tabpanel"
        aria-labelledby={`stage-tab-${stage.step}`}
        data-stage-panel={stage.step}
        class:list={[idx === 0 ? 'block' : 'hidden']}
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-500/30 mb-4">
              <span>STAGE {stage.step} OF 05</span>
              &bull;
              <span>{stage.tagline}</span>
            </div>
            <h4 class="text-3xl font-extrabold text-white tracking-tight mb-4">
              {stage.name}: <span class="text-blue-400 font-semibold">{stage.tagline}</span>
            </h4>
            <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-6">
              {stage.description}
            </p>
            <div class="space-y-2.5">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Enforced Architectural Gates:</span>
              <div class="flex flex-wrap gap-2">
                {stage.gates.map((gate) => (
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800/80 border border-slate-700 text-slate-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    {gate}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 bg-slate-800/60 p-6 rounded-2xl border border-slate-700/80">
            <div class="text-xs font-mono text-blue-400 uppercase tracking-wider mb-2">Stage Telemetry & Boundary</div>
            <div class="space-y-3 text-xs text-slate-300">
              <div class="flex justify-between py-1.5 border-b border-slate-700/60">
                <span class="text-slate-400">Operator Role:</span>
                <span class="font-semibold text-white">Migration Operator / Tenant Admin</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-slate-700/60">
                <span class="text-slate-400">Execution Mode:</span>
                <span class="font-semibold text-emerald-400">Guarded / Circuit-Breaker Protected</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-slate-700/60">
                <span class="text-slate-400">Audit Trail:</span>
                <span class="font-semibold text-white">SHA-256 Hash Chain Record</span>
              </div>
              <div class="flex justify-between py-1.5">
                <span class="text-slate-400">Customer Data Retention:</span>
                <span class="font-semibold text-blue-300">0 Bytes at Rest (Streamed)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  function setupLifecycleStepper() {
    const root = document.querySelector('[data-lifecycle-root]');
    if (!root) return;

    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-stage-target]');
    const panels = root.querySelectorAll<HTMLElement>('[data-stage-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetStep = tab.getAttribute('data-stage-target');

        tabs.forEach((t) => {
          const isSelected = t.getAttribute('data-stage-target') === targetStep;
          t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          if (isSelected) {
            t.classList.add('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-lg', 'shadow-blue-600/20');
            t.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
          } else {
            t.classList.remove('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-lg', 'shadow-blue-600/20');
            t.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
          }
        });

        panels.forEach((p) => {
          const isMatch = p.getAttribute('data-stage-panel') === targetStep;
          p.classList.toggle('hidden', !isMatch);
          p.classList.toggle('block', isMatch);
        });
      });
    });
  }

  setupLifecycleStepper();
  document.addEventListener('astro:page-load', setupLifecycleStepper);
</script>

