---
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Col 1: About -->
      <div>
        <a href="/" class="inline-block mb-6 group" aria-label="Prana Solutions Tech Home">
          <img
            src="/assets/images/prana-solutions-logo-white.png"
            alt="Prana Solutions Tech"
            width="200"
            height="50"
            class="h-10 sm:h-11 w-auto object-contain transition-opacity group-hover:opacity-90"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-sm text-slate-400 mb-6 leading-relaxed">
          Premier Microsoft Solutions Partner delivering enterprise cloud infrastructure, cyber security, managed IT services, and digital transformation across the UK and internationally.
        </p>
        <div class="text-sm text-slate-400 space-y-1">
          <p><strong>Registered in England & Wales</strong></p>
          <p>London, United Kingdom</p>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Core Services</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/cyber-security" class="hover:text-blue-400 transition">Cyber Security & Zero Trust</a></li>
          <li><a href="/digital-transformation" class="hover:text-blue-400 transition">Digital Transformation</a></li>
          <li><a href="/cloud-infrastructure" class="hover:text-blue-400 transition">Cloud & Azure Infrastructure</a></li>
          <li><a href="/it-support-managed-services" class="hover:text-blue-400 transition">Managed IT & 24/7 SLA Support</a></li>
          <li><a href="/bridgead" class="hover:text-blue-400 transition">BridgeAD Migration Platform</a></li>
        </ul>
      </div>

      <!-- Col 3: Company -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Company</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/who-we-are" class="hover:text-blue-400 transition">Who We Are</a></li>
          <li><a href="/case-studies" class="hover:text-blue-400 transition">Client Case Studies</a></li>
          <li><a href="/blog" class="hover:text-blue-400 transition">Insights & Thought Leadership</a></li>
          <li><a href="/faq" class="hover:text-blue-400 transition">Frequently Asked Questions</a></li>
          <li><a href="/contact" class="hover:text-blue-400 transition">Contact Us</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact info -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Get in Touch</h3>
        <div class="space-y-3 text-sm text-slate-400">
          <p class="flex items-start gap-2">
            <span class="text-blue-400 font-medium">Email:</span>
            <a href="mailto:info@pranast.com" class="hover:text-white transition">info@pranast.com</a>
          </p>
          <p class="flex items-start gap-2">
            <span class="text-blue-400 font-medium">Location:</span>
            <span>United Kingdom</span>
          </p>
          <div class="pt-4">
            <a
              href="/contact"
              class="inline-block px-4 py-2 text-xs font-semibold uppercase tracking-wider text-blue-400 border border-blue-400 rounded hover:bg-blue-400 hover:text-slate-900 transition"
            >
              Request Assessment
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; {year} Prana Solutions Tech Limited. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy-policy" class="hover:text-slate-400 transition">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-slate-400 transition">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

