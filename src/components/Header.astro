---
interface NavItem {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
}

const navItems: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Who We Are', href: '/who-we-are' },
  {
    label: 'Services',
    href: '/#services',
    children: [
      { label: 'Cyber Security', href: '/cyber-security' },
      { label: 'Digital Transformation', href: '/digital-transformation' },
      { label: 'Cloud & Infrastructure', href: '/cloud-infrastructure' },
      { label: 'IT Support & Managed Services', href: '/it-support-managed-services' },
    ],
  },
  {
    label: 'Technology and Innovation',
    href: '/#technology-innovation',
    children: [
      { label: 'BridgeAD', href: '/bridgead' },
    ],
  },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Blog', href: '/blog' },
  { label: 'FAQ', href: '/faq' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3">
        <img
          src="/assets/images/cropped-PST_LOGORemovebg.png"
          alt="Prana Solutions Tech"
          class="h-12 w-auto object-contain"
          onerror="this.onerror=null; this.src='/assets/images/prana-Logo.png';"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-4 xl:gap-6">
        {navItems.map((item) => (
          item.children ? (
            <div class="relative group">
              <button class={`flex items-center gap-1 py-2 text-sm font-medium transition ${
                item.children.some((child) => currentPath === child.href || currentPath === child.href + '/')
                  ? 'text-blue-600 font-semibold'
                  : 'text-slate-700 hover:text-blue-600'
              }`}>
                <span>{item.label}</span>
                <svg class="w-4 h-4 transition group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block w-64 pt-2 shadow-lg">
                <div class="bg-white rounded-lg border border-slate-100 py-2 shadow-md">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class={`block px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition ${
                        currentPath === child.href || currentPath === child.href + '/' ? 'text-blue-600 font-semibold bg-blue-50/50' : ''
                      }`}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={`py-2 text-sm font-medium transition ${
                currentPath === item.href || currentPath === item.href + '/'
                  ? 'text-blue-600 font-semibold'
                  : 'text-slate-700 hover:text-blue-600'
              }`}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <!-- CTA Button -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href="/contact"
          class="inline-flex items-center px-5 py-2.5 rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition"
        >
          Get in Touch
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-md text-slate-700 hover:bg-slate-100 focus:outline-none"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-2 pb-6 space-y-2">
    {navItems.map((item) => (
      item.children ? (
        <div class="py-2">
          <div class={`font-semibold text-sm px-2 mb-1 ${
            item.children.some((child) => currentPath === child.href || currentPath === child.href + '/')
              ? 'text-blue-600'
              : 'text-slate-800'
          }`}>{item.label}</div>
          <div class="pl-4 space-y-1">
            {item.children.map((child) => (
              <a
                href={child.href}
                class={`block py-1.5 text-sm transition ${
                  currentPath === child.href || currentPath === child.href + '/'
                    ? 'text-blue-600 font-semibold'
                    : 'text-slate-600 hover:text-blue-600'
                }`}
              >
                {child.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class={`block py-2 text-sm font-medium transition ${
            currentPath === item.href || currentPath === item.href + '/'
              ? 'text-blue-600 font-semibold'
              : 'text-slate-700 hover:text-blue-600'
          }`}
        >
          {item.label}
        </a>
      )
    ))}
    <div class="pt-4 border-t border-slate-100">
      <a
        href="/contact"
        class="block w-full text-center px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm"
      >
        Get in Touch
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>

